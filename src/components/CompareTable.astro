---
import Status from './Status.astro';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, RADIO_LABELS, devicePath, type Device } from '../lib/devices';
interface Props {
  devices: Device[];
}
const { devices } = Astro.props;
---

<div class="table-scroll">
  <table role="table" class="stack">
    <thead role="rowgroup">
      <tr role="row">
        <th role="columnheader" scope="col">Device</th>
        <th role="columnheader" scope="col">Radio</th>
        <th role="columnheader" scope="col">Matter</th>
        {ECOSYSTEMS.map((e) => <th role="columnheader" scope="col">{ECOSYSTEM_LABELS[e]}</th>)}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        devices.map((dev) => {
          const d = dev.data;
          return (
            <tr role="row">
              <th role="rowheader" scope="row" class="name">
                <a href={devicePath(dev)}>{d.name}</a>
                <span class="note">{d.model} · {d.regions.join('/')}</span>
              </th>
              <td role="cell" data-label="Radio">{(d.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || '—'}</td>
              <td role="cell" data-label="Matter">
                <span class={`badge s-${d.matter.certified}`}>
                  {d.matter.certified === null ? 'Unconfirmed' : d.matter.certified ? 'Yes' : 'No'}
                </span>
              </td>
              {ECOSYSTEMS.map((e) => (
                <td role="cell" data-label={ECOSYSTEM_LABELS[e]}>
                  <Status status={d.compatibility[e].status} via={d.compatibility[e].via} compact />
                </td>
              ))}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

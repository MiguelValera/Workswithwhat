---
import { ECOSYSTEMS, ECOSYSTEM_LABELS, devicePathIn, getTranslations, radioList, worksWith, type Device } from '../lib/devices';
import { langOf } from '../i18n/lang';
import { ui } from '../i18n/ui';
interface Props {
  device: Device;
}
const { device } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = ui(lang);
const d = device.data;
const works = ECOSYSTEMS.filter((e) => worksWith(device, e));
const radios = radioList(d.radios.value, lang, ' + ');
const href = devicePathIn(device, lang, await getTranslations(lang));
---

<li class="card">
  <h3><a href={href}>{d.name}</a></h3>
  <div class="muted">
    {d.model} · {d.regions.join('/')}{radios && ` · ${radios}`}{d.matter.certified && ' · Matter'}
  </div>
  <div class="eco">
    {works.map((e) => <span class="badge s-native">{ECOSYSTEM_LABELS[e]}</span>)}
    {works.length === 0 && <span class="badge s-unknown">{t.noConfirmedEcosystems}</span>}
  </div>
</li>

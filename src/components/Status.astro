---
import { STATUS_TEXT } from '../lib/devices';
interface Props {
  status: keyof typeof STATUS_TEXT;
  via?: string;
  compact?: boolean;
}
const { status, via, compact = false } = Astro.props;
const text = status === 'hub' && via && !compact ? `Via ${via}` : STATUS_TEXT[status];
---

<span class={`badge s-${status}`} title={status === 'hub' && via ? `Needs ${via}` : undefined}>{text}</span>

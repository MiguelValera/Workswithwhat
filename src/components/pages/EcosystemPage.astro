---
// "Devices that work with <ecosystem>": every market (/works-with/apple-home/, one table per
// market) or one market (/us/works-with/apple-home/).
import Base from '../../layouts/Base.astro';
import DeviceNameCell from '../DeviceNameCell.astro';
import Refs from '../Refs.astro';
import Status from '../Status.astro';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  deviceText,
  devicePathIn,
  ecosystemPath,
  getTranslations,
  radioList,
  getPublishedDevices,
  categoryPhrase,
  type Device,
  worksWith,
  type Ecosystem,
} from '../../lib/devices';
import { CATEGORIES, catText } from '../../lib/categories';
import { byMarket, marketOf, marketText, regionOrGlobal, type Market } from '../../lib/markets';
import { pick, capitalize, langOf, localize } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  eco: Ecosystem;
  market?: Market;
}
const { eco, market } = Astro.props;
const lang = langOf(Astro.url.pathname);
const T = pick(lang);
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const translations = await getTranslations(lang);
const mt = market && marketText(market, lang);
const label = ECOSYSTEM_LABELS[eco];
const all = (await getPublishedDevices()).filter((d) => !market || marketOf(d) === market);
const path = market ? `/${market.key}${ecosystemPath(eco)}` : ecosystemPath(eco);
// in a region page every table is one market already; elsewhere split each category by market
const split = (list: Device[]) => (market ? [{ market, devices: list }] : byMarket(list));
const otherLinks = await Promise.all(
  ECOSYSTEMS.filter((e) => e !== eco).map(async (e) => ({ e, href: L(await regionOrGlobal(market, ecosystemPath(e))) })),
);
const yes = all.filter((d) => worksWith(d, eco));
const viaMatter = yes.filter((d) => d.data.compatibility[eco].status === 'matter').length;
const groups = CATEGORIES.map((cat) => ({
  cat,
  yes: yes.filter((d) => d.data.category === cat.key),
  unsure: all.filter((d) => d.data.category === cat.key && d.data.compatibility[eco].status === 'unknown'),
  total: all.filter((d) => d.data.category === cat.key).length,
})).filter((g) => g.total > 0);
const { short: what, long: whatLong } = categoryPhrase(groups.map((g) => catText(g.cat, lang).plural), lang);
const What = capitalize(what);

// General, stable facts about how devices reach each platform. Device-specific
// claims stay in the device records, where they are sourced.
const HOW_EN: Record<Ecosystem, string[]> = {
  apple_home: [
    'A device reaches Apple Home in one of two ways: it supports HomeKit directly, or it is Matter-certified and you add it with the Home app\'s Matter pairing.',
    'Automations and remote control need an Apple home hub (an Apple TV or a HomePod). Thread devices also need a Thread border router, which recent HomePod and Apple TV models include.',
  ],
  google_home: [
    'Devices connect to Google Home through the brand\'s own account linking (cloud to cloud) or through Matter.',
    'Matter needs a Google device that acts as a Matter hub, such as a Nest speaker or display. Thread devices also need a Google device that works as a Thread border router.',
  ],
  alexa: [
    'Devices connect to Alexa through the brand\'s Alexa skill (cloud to cloud) or through Matter.',
    'Matter needs an Echo device that works as a Matter controller, and Thread devices need an Echo that is also a Thread border router.',
  ],
  smartthings: [
    'Devices reach SmartThings through a cloud-to-cloud integration, through Matter, or as Zigbee devices paired to a SmartThings hub.',
    'Matter and Zigbee devices need a SmartThings hub. Some Samsung TVs and appliances can act as one.',
  ],
  home_assistant: [
    'Home Assistant connects to devices through brand integrations (many of them local), through its Matter integration, or through a Zigbee coordinator.',
    'Local integrations keep working without the internet, which is why we note local control on each device.',
  ],
};

const HOW_ES: Record<Ecosystem, string[]> = {
  apple_home: [
    'Un dispositivo llega a Apple Home (la app Casa) de dos formas: es compatible con HomeKit directamente, o tiene certificación Matter y lo añades con el emparejamiento Matter de la app Casa.',
    'Las automatizaciones y el control a distancia necesitan un centro de la casa de Apple (un Apple TV o un HomePod). Los dispositivos Thread también necesitan un router de borde Thread, que incluyen los HomePod y Apple TV recientes.',
  ],
  google_home: [
    'Los dispositivos se conectan a Google Home vinculando la cuenta de la marca (de nube a nube) o mediante Matter.',
    'Matter necesita un dispositivo de Google que haga de hub Matter, como un altavoz o una pantalla Nest. Los dispositivos Thread necesitan además un dispositivo de Google que funcione como router de borde Thread.',
  ],
  alexa: [
    'Los dispositivos se conectan a Alexa mediante la skill de la marca (de nube a nube) o mediante Matter.',
    'Matter necesita un Echo que funcione como controlador Matter, y los dispositivos Thread necesitan un Echo que además sea router de borde Thread.',
  ],
  smartthings: [
    'Los dispositivos llegan a SmartThings mediante una integración de nube a nube, mediante Matter o como dispositivos Zigbee emparejados con un hub SmartThings.',
    'Los dispositivos Matter y Zigbee necesitan un hub SmartThings. Algunos televisores y electrodomésticos Samsung pueden hacer de hub.',
  ],
  home_assistant: [
    'Home Assistant se conecta a los dispositivos mediante integraciones de cada marca (muchas de ellas locales), su integración Matter o un coordinador Zigbee.',
    'Las integraciones locales siguen funcionando sin internet; por eso indicamos el control local en cada dispositivo.',
  ],
};

const HOW_DE: Record<Ecosystem, string[]> = {
  apple_home: [
    'Ein Gerät kommt auf zwei Wegen in Apple Home: Es unterstützt HomeKit direkt, oder es ist Matter-zertifiziert und du fügst es per Matter-Kopplung in der Home-App hinzu.',
    'Automationen und Fernzugriff brauchen eine Apple-Steuerzentrale (ein Apple TV oder einen HomePod). Thread-Geräte brauchen außerdem einen Thread-Border-Router, den aktuelle HomePod- und Apple-TV-Modelle eingebaut haben.',
  ],
  google_home: [
    'Geräte verbinden sich mit Google Home über die Kontoverknüpfung der Marke (Cloud zu Cloud) oder über Matter.',
    'Matter braucht ein Google-Gerät, das als Matter-Hub dient, etwa einen Nest-Lautsprecher oder ein Nest-Display. Thread-Geräte brauchen außerdem ein Google-Gerät, das als Thread-Border-Router arbeitet.',
  ],
  alexa: [
    'Geräte verbinden sich mit Alexa über den Alexa-Skill der Marke (Cloud zu Cloud) oder über Matter.',
    'Matter braucht ein Echo-Gerät, das als Matter-Controller arbeitet, und Thread-Geräte brauchen einen Echo, der auch Thread-Border-Router ist.',
  ],
  smartthings: [
    'Geräte kommen über eine Cloud-zu-Cloud-Integration, über Matter oder als Zigbee-Geräte an einem SmartThings-Hub in SmartThings.',
    'Matter- und Zigbee-Geräte brauchen einen SmartThings-Hub. Manche Samsung-Fernseher und -Haushaltsgeräte können diese Rolle übernehmen.',
  ],
  home_assistant: [
    'Home Assistant verbindet sich mit Geräten über Integrationen der Marken (viele davon lokal), über die Matter-Integration oder über einen Zigbee-Koordinator.',
    'Lokale Integrationen funktionieren auch ohne Internet; deshalb geben wir bei jedem Gerät an, ob es lokal steuerbar ist.',
  ],
};

const HOW_FR: Record<Ecosystem, string[]> = {
  apple_home: [
    'Un appareil rejoint Apple Home de deux façons : il prend en charge HomeKit directement, ou il est certifié Matter et vous l’ajoutez avec l’appairage Matter de l’app Maison.',
    'Les automatisations et le contrôle à distance nécessitent un concentrateur domestique Apple (une Apple TV ou un HomePod). Les appareils Thread ont aussi besoin d’un routeur de bordure Thread, intégré aux HomePod et Apple TV récents.',
  ],
  google_home: [
    'Les appareils se connectent à Google Home en associant le compte de la marque (de cloud à cloud) ou via Matter.',
    'Matter nécessite un appareil Google qui sert de hub Matter, comme une enceinte ou un écran Nest. Les appareils Thread ont aussi besoin d’un appareil Google qui fait office de routeur de bordure Thread.',
  ],
  alexa: [
    'Les appareils se connectent à Alexa via la skill Alexa de la marque (de cloud à cloud) ou via Matter.',
    'Matter nécessite un Echo qui fait office de contrôleur Matter, et les appareils Thread un Echo qui est aussi routeur de bordure Thread.',
  ],
  smartthings: [
    'Les appareils rejoignent SmartThings par une intégration de cloud à cloud, via Matter, ou comme appareils Zigbee appairés à un hub SmartThings.',
    'Les appareils Matter et Zigbee nécessitent un hub SmartThings. Certains téléviseurs et appareils électroménagers Samsung peuvent jouer ce rôle.',
  ],
  home_assistant: [
    'Home Assistant se connecte aux appareils par les intégrations des marques (souvent locales), par son intégration Matter ou par un coordinateur Zigbee.',
    'Les intégrations locales continuent de fonctionner sans internet ; c’est pourquoi nous indiquons le contrôle local pour chaque appareil.',
  ],
};

const HOW_IT: Record<Ecosystem, string[]> = {
  apple_home: [
    'Un dispositivo arriva in Apple Home in due modi: supporta HomeKit direttamente, oppure è certificato Matter e lo aggiungi con l’abbinamento Matter dell’app Casa.',
    'Automazioni e controllo da remoto richiedono un hub domestico Apple (una Apple TV o un HomePod). I dispositivi Thread richiedono anche un border router Thread, integrato nei HomePod e nelle Apple TV recenti.',
  ],
  google_home: [
    'I dispositivi si collegano a Google Home collegando l’account del marchio (da cloud a cloud) o tramite Matter.',
    'Matter richiede un dispositivo Google che faccia da hub Matter, come uno speaker o un display Nest. I dispositivi Thread richiedono anche un dispositivo Google che funzioni da border router Thread.',
  ],
  alexa: [
    'I dispositivi si collegano ad Alexa tramite la skill Alexa del marchio (da cloud a cloud) o tramite Matter.',
    'Matter richiede un Echo che funzioni da controller Matter, e i dispositivi Thread un Echo che sia anche border router Thread.',
  ],
  smartthings: [
    'I dispositivi arrivano in SmartThings con un’integrazione da cloud a cloud, tramite Matter o come dispositivi Zigbee abbinati a un hub SmartThings.',
    'I dispositivi Matter e Zigbee richiedono un hub SmartThings. Alcuni televisori ed elettrodomestici Samsung possono fare da hub.',
  ],
  home_assistant: [
    'Home Assistant si collega ai dispositivi tramite le integrazioni dei marchi (molte locali), la sua integrazione Matter o un coordinatore Zigbee.',
    'Le integrazioni locali continuano a funzionare senza internet; per questo indichiamo il controllo locale per ogni dispositivo.',
  ],
};
const HOW = T({ en: HOW_EN, es: HOW_ES, de: HOW_DE, fr: HOW_FR, it: HOW_IT });

const title = T({
  en: market ? `${What} that work with ${label} in ${market.phrase}` : `${What} that work with ${label}`,
  es: `${What} compatibles con ${label}${mt ? ` en ${mt.phrase}` : ''}`,
  de: `${What}${mt ? ` ${mt.inPhrase}` : ''}, die mit ${label} funktionieren`,
  fr: `${What} compatibles avec ${label}${mt ? ` ${mt.inPhrase}` : ''}`,
  it: `${What} compatibili con ${label}${mt ? ` ${mt.inPhrase}` : ''}`,
});
const n = yes.length;
const description = T({
  en: `${n} ${whatLong} ${market ? `for ${market.phrase} ` : ''}confirmed to work with ${label}${viaMatter ? `, ${viaMatter} of them via Matter` : ''}. See which need a hub, and check the source for each one.`,
  es: `${n} ${whatLong}${mt ? ` para ${mt.phrase}` : ''} con compatibilidad confirmada con ${label}${viaMatter ? `, ${viaMatter} de ellos mediante Matter` : ''}. Consulta cuáles necesitan hub y la fuente de cada uno.`,
  de: `${n} ${whatLong}${mt ? ` für ${mt.phrase}` : ''} mit bestätigter Kompatibilität mit ${label}${viaMatter ? `, ${viaMatter} davon über Matter` : ''}. Sieh nach, welche einen Hub brauchen, und prüfe die Quelle zu jedem Gerät.`,
  fr: `${n} ${whatLong}${mt ? ` pour ${mt.phrase}` : ''} dont la compatibilité avec ${label} est confirmée${viaMatter ? `, dont ${viaMatter} via Matter` : ''}. Voyez lesquels nécessitent un hub et consultez la source de chacun.`,
  it: `${n} ${whatLong}${mt ? ` per ${mt.phrase}` : ''} con compatibilità confermata con ${label}${viaMatter ? `, ${viaMatter} dei quali tramite Matter` : ''}. Scopri quali richiedono un hub e controlla la fonte di ciascuno.`,
});
---

<Base
  title={title}
  description={description}
  crumbs={
    market
      ? [
          { name: mt!.label, path: `/${market.key}/` },
          { name: label, path },
        ]
      : [
          { name: t.navByEcosystem, path: '/works-with/' },
          { name: label, path },
        ]
  }
>
  <h1>{title}</h1>
  <p class="lede">
    {T({
      en: `${n} of the ${all.length} devices we've checked${market ? ` for ${market.phrase}` : ''} work with ${label}.`,
      es: `${n} de los ${all.length} dispositivos que hemos comprobado${mt ? ` para ${mt.phrase}` : ''} funcionan con ${label}.`,
      de: `${n} der ${all.length} Geräte, die wir${mt ? ` für ${mt.phrase}` : ''} geprüft haben, funktionieren mit ${label}.`,
      fr: `${n} des ${all.length} appareils que nous avons vérifiés${mt ? ` pour ${mt.phrase}` : ''} fonctionnent avec ${label}.`,
      it: `${n} dei ${all.length} dispositivi che abbiamo verificato${mt ? ` per ${mt.phrase}` : ''} funzionano con ${label}.`,
    })}
    {viaMatter > 0 &&
      T({
        en: ` ${viaMatter} connect through Matter rather than a brand integration.`,
        es: ` ${viaMatter} se conectan mediante Matter en lugar de una integración de la marca.`,
        de: ` ${viaMatter} davon verbinden sich über Matter statt über eine Integration der Marke.`,
        fr: ` ${viaMatter} passent par Matter plutôt que par une intégration de la marque.`,
        it: ` ${viaMatter} si collegano tramite Matter invece che con un’integrazione del marchio.`,
      })}
  </p>
  <nav class="toc" aria-label={T({ en: 'On this page', es: 'En esta página', de: 'Auf dieser Seite', fr: 'Sur cette page', it: 'In questa pagina' })}>
    <span class="toc-label">{t.jumpTo}</span>
    {groups.map((g) => <a href={`#${g.cat.path}`}>{catText(g.cat, lang).label} ({g.yes.length})</a>)}
    <a href="#how">{T({ en: 'How devices connect', es: 'Cómo se conectan', de: 'So verbinden sich Geräte', fr: 'Comment ils se connectent', it: 'Come si collegano' })}</a>
  </nav>
  <h2 id="how">{T({
      en: `How devices connect to ${label}`,
      es: `Cómo se conectan los dispositivos a ${label}`,
      de: `So verbinden sich Geräte mit ${label}`,
      fr: `Comment les appareils se connectent à ${label}`,
      it: `Come si collegano i dispositivi a ${label}`,
    })}</h2>
  {HOW[eco].map((p) => <p>{p}</p>)}

  {
    groups.map((g) => (
      <section aria-labelledby={g.cat.path}>
        <h2 id={g.cat.path}>{T({
          en: `${g.cat.label} that work with ${label}`,
          es: `${catText(g.cat, lang).label} compatibles con ${label}`,
          de: `${catText(g.cat, lang).label}, die mit ${label} funktionieren`,
          fr: `${catText(g.cat, lang).label} compatibles avec ${label}`,
          it: `${catText(g.cat, lang).label} compatibili con ${label}`,
        })}</h2>
        {g.yes.length > 0 ? (
          split(g.yes).map((m) => (
          <>
          {!market && <h3 id={`${g.cat.path}-${m.market.key}`}>{marketText(m.market, lang).label} ({m.devices.length})</h3>}
          <div class="table-scroll">
            <table role="table" class="stack pair">
              <thead role="rowgroup">
                <tr role="row"><th role="columnheader" scope="col">{t.device}</th><th role="columnheader" scope="col">{t.how}</th><th role="columnheader" scope="col">{t.radio}</th><th role="columnheader" scope="col">{t.notes}</th></tr>
              </thead>
              <tbody role="rowgroup">
                {m.devices.map((d) => {
                  const c = d.data.compatibility[eco];
                  const words = deviceText(d, lang, translations.get(d.id));
                  const href = devicePathIn(d, lang, translations);
                  return (
                    <tr role="row">
                      <DeviceNameCell device={d} href={href} />
                      <td role="cell" data-label={t.how}><Status status={c.status} via={words.via(eco)} /></td>
                      <td role="cell" data-label={t.radio}>{radioList(d.data.radios.value, lang) || '—'}</td>
                      <td role="cell" class="wide">{words.compatNote(eco)}<Refs ids={c.sources} all={d.data.sources} base={href} /></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          </>
          ))
        ) : (
          <p>{T({
            en: `None of the ${g.cat.plural} we've checked so far are confirmed for ${label}.`,
            es: `Por ahora no hay ${catText(g.cat, lang).plural} comprobados con compatibilidad confirmada con ${label}.`,
            de: `Noch kein geprüftes Gerät dieser Kategorie ist für ${label} bestätigt.`,
            fr: `Aucun appareil de cette catégorie vérifié jusqu’ici n’est confirmé pour ${label}.`,
            it: `Nessun dispositivo di questa categoria verificato finora è confermato per ${label}.`,
          })}</p>
        )}
        {g.unsure.length > 0 && (
          <p class="muted small">
            {T({ en: 'Not confirmed either way:', es: 'Sin confirmar ni descartar:', de: 'Weder bestätigt noch ausgeschlossen:', fr: 'Ni confirmé ni exclu :', it: 'Né confermato né escluso:' })}{' '}
            {g.unsure.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={devicePathIn(d, lang, translations)}>{d.data.name}</a>
              </>
            ))}.
          </p>
        )}
      </section>
    ))
  }

  <p class="muted">
    {T({ en: 'Other platforms:', es: 'Otras plataformas:', de: 'Andere Plattformen:', fr: 'Autres plateformes :', it: 'Altre piattaforme:' })}{' '}
    {
      otherLinks.map(({ e, href }, i) => (
        <>
          {i > 0 && ' · '}
          <a href={href}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

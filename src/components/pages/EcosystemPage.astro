---
// "Devices that work with <ecosystem>": every market (/works-with/apple-home/, one table per
// market) or one market (/us/works-with/apple-home/).
import Base from '../../layouts/Base.astro';
import DeviceNameCell from '../DeviceNameCell.astro';
import Refs from '../Refs.astro';
import Status from '../Status.astro';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  deviceText,
  devicePathIn,
  ecosystemPath,
  getTranslations,
  radioList,
  getPublishedDevices,
  categoryPhrase,
  type Device,
  worksWith,
  type Ecosystem,
} from '../../lib/devices';
import { CATEGORIES, catText } from '../../lib/categories';
import { byMarket, marketOf, marketText, regionOrGlobal, type Market } from '../../lib/markets';
import { capitalize, langOf, localize } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  eco: Ecosystem;
  market?: Market;
}
const { eco, market } = Astro.props;
const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const translations = await getTranslations();
const mt = market && marketText(market, lang);
const label = ECOSYSTEM_LABELS[eco];
const all = (await getPublishedDevices()).filter((d) => !market || marketOf(d) === market);
const path = market ? `/${market.key}${ecosystemPath(eco)}` : ecosystemPath(eco);
// in a region page every table is one market already; elsewhere split each category by market
const split = (list: Device[]) => (market ? [{ market, devices: list }] : byMarket(list));
const otherLinks = await Promise.all(
  ECOSYSTEMS.filter((e) => e !== eco).map(async (e) => ({ e, href: L(await regionOrGlobal(market, ecosystemPath(e))) })),
);
const yes = all.filter((d) => worksWith(d, eco));
const viaMatter = yes.filter((d) => d.data.compatibility[eco].status === 'matter').length;
const groups = CATEGORIES.map((cat) => ({
  cat,
  yes: yes.filter((d) => d.data.category === cat.key),
  unsure: all.filter((d) => d.data.category === cat.key && d.data.compatibility[eco].status === 'unknown'),
  total: all.filter((d) => d.data.category === cat.key).length,
})).filter((g) => g.total > 0);
const { short: what, long: whatLong } = categoryPhrase(groups.map((g) => catText(g.cat, lang).plural), lang);
const What = capitalize(what);

// General, stable facts about how devices reach each platform. Device-specific
// claims stay in the device records, where they are sourced.
const HOW: Record<Ecosystem, string[]> = {
  apple_home: [
    'A device reaches Apple Home in one of two ways: it supports HomeKit directly, or it is Matter-certified and you add it with the Home app\'s Matter pairing.',
    'Automations and remote control need an Apple home hub (an Apple TV or a HomePod). Thread devices also need a Thread border router, which recent HomePod and Apple TV models include.',
  ],
  google_home: [
    'Devices connect to Google Home through the brand\'s own account linking (cloud to cloud) or through Matter.',
    'Matter needs a Google device that acts as a Matter hub, such as a Nest speaker or display. Thread devices also need a Google device that works as a Thread border router.',
  ],
  alexa: [
    'Devices connect to Alexa through the brand\'s Alexa skill (cloud to cloud) or through Matter.',
    'Matter needs an Echo device that works as a Matter controller, and Thread devices need an Echo that is also a Thread border router.',
  ],
  smartthings: [
    'Devices reach SmartThings through a cloud-to-cloud integration, through Matter, or as Zigbee devices paired to a SmartThings hub.',
    'Matter and Zigbee devices need a SmartThings hub. Some Samsung TVs and appliances can act as one.',
  ],
  home_assistant: [
    'Home Assistant connects to devices through brand integrations (many of them local), through its Matter integration, or through a Zigbee coordinator.',
    'Local integrations keep working without the internet, which is why we note local control on each device.',
  ],
};

const HOW_ES: Record<Ecosystem, string[]> = {
  apple_home: [
    'Un dispositivo llega a Apple Home (la app Casa) de dos formas: es compatible con HomeKit directamente, o tiene certificación Matter y lo añades con el emparejamiento Matter de la app Casa.',
    'Las automatizaciones y el control a distancia necesitan un centro de la casa de Apple (un Apple TV o un HomePod). Los dispositivos Thread también necesitan un router de borde Thread, que incluyen los HomePod y Apple TV recientes.',
  ],
  google_home: [
    'Los dispositivos se conectan a Google Home vinculando la cuenta de la marca (de nube a nube) o mediante Matter.',
    'Matter necesita un dispositivo de Google que haga de hub Matter, como un altavoz o una pantalla Nest. Los dispositivos Thread necesitan además un dispositivo de Google que funcione como router de borde Thread.',
  ],
  alexa: [
    'Los dispositivos se conectan a Alexa mediante la skill de la marca (de nube a nube) o mediante Matter.',
    'Matter necesita un Echo que funcione como controlador Matter, y los dispositivos Thread necesitan un Echo que además sea router de borde Thread.',
  ],
  smartthings: [
    'Los dispositivos llegan a SmartThings mediante una integración de nube a nube, mediante Matter o como dispositivos Zigbee emparejados con un hub SmartThings.',
    'Los dispositivos Matter y Zigbee necesitan un hub SmartThings. Algunos televisores y electrodomésticos Samsung pueden hacer de hub.',
  ],
  home_assistant: [
    'Home Assistant se conecta a los dispositivos mediante integraciones de cada marca (muchas de ellas locales), su integración Matter o un coordinador Zigbee.',
    'Las integraciones locales siguen funcionando sin internet; por eso indicamos el control local en cada dispositivo.',
  ],
};

const title = es
  ? `${What} compatibles con ${label}${mt ? ` en ${mt.phrase}` : ''}`
  : market
    ? `${What} that work with ${label} in ${market.phrase}`
    : `${What} that work with ${label}`;
const description = es
  ? `${yes.length} ${whatLong}${mt ? ` para ${mt.phrase}` : ''} con compatibilidad confirmada con ${label}${viaMatter ? `, ${viaMatter} de ellos mediante Matter` : ''}. Consulta cuáles necesitan hub y la fuente de cada uno.`
  : `${yes.length} ${whatLong} ${market ? `for ${market.phrase} ` : ''}confirmed to work with ${label}${viaMatter ? `, ${viaMatter} of them via Matter` : ''}. See which need a hub, and check the source for each one.`;
---

<Base
  title={title}
  description={description}
  crumbs={
    market
      ? [
          { name: mt!.label, path: `/${market.key}/` },
          { name: label, path },
        ]
      : [
          { name: t.navByEcosystem, path: '/works-with/' },
          { name: label, path },
        ]
  }
>
  <h1>{title}</h1>
  {
    es ? (
      <p class="lede">
        {yes.length} de los {all.length} dispositivos que hemos comprobado{mt && ` para ${mt.phrase}`} funcionan con {label}.
        {viaMatter > 0 && ` ${viaMatter} se conectan mediante Matter en lugar de una integración de la marca.`}
      </p>
    ) : (
      <p class="lede">
        {yes.length} of the {all.length} devices we've checked{market && ` for ${market.phrase}`} work with {label}.
        {viaMatter > 0 && ` ${viaMatter} connect through Matter rather than a brand integration.`}
      </p>
    )
  }
  <nav class="toc" aria-label={es ? 'En esta página' : 'On this page'}>
    <span class="toc-label">{t.jumpTo}</span>
    {groups.map((g) => <a href={`#${g.cat.path}`}>{catText(g.cat, lang).label} ({g.yes.length})</a>)}
    <a href="#how">{es ? 'Cómo se conectan' : 'How devices connect'}</a>
  </nav>
  <h2 id="how">{es ? `Cómo se conectan los dispositivos a ${label}` : `How devices connect to ${label}`}</h2>
  {(es ? HOW_ES : HOW)[eco].map((p) => <p>{p}</p>)}

  {
    groups.map((g) => (
      <section aria-labelledby={g.cat.path}>
        <h2 id={g.cat.path}>{es ? `${catText(g.cat, lang).label} compatibles con ${label}` : `${g.cat.label} that work with ${label}`}</h2>
        {g.yes.length > 0 ? (
          split(g.yes).map((m) => (
          <>
          {!market && <h3 id={`${g.cat.path}-${m.market.key}`}>{marketText(m.market, lang).label} ({m.devices.length})</h3>}
          <div class="table-scroll">
            <table role="table" class="stack pair">
              <thead role="rowgroup">
                <tr role="row"><th role="columnheader" scope="col">{t.device}</th><th role="columnheader" scope="col">{t.how}</th><th role="columnheader" scope="col">{t.radio}</th><th role="columnheader" scope="col">{t.notes}</th></tr>
              </thead>
              <tbody role="rowgroup">
                {m.devices.map((d) => {
                  const c = d.data.compatibility[eco];
                  const words = deviceText(d, lang, translations.get(d.id));
                  const href = devicePathIn(d, lang, translations);
                  return (
                    <tr role="row">
                      <DeviceNameCell device={d} href={href} />
                      <td role="cell" data-label={t.how}><Status status={c.status} via={words.via(eco)} /></td>
                      <td role="cell" data-label={t.radio}>{radioList(d.data.radios.value, lang) || '—'}</td>
                      <td role="cell" class="wide">{words.compatNote(eco)}<Refs ids={c.sources} all={d.data.sources} base={href} /></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          </>
          ))
        ) : (
          <p>{es ? `Por ahora no hay ${catText(g.cat, lang).plural} comprobados con compatibilidad confirmada con ${label}.` : `None of the ${g.cat.plural} we've checked so far are confirmed for ${label}.`}</p>
        )}
        {g.unsure.length > 0 && (
          <p class="muted small">
            {es ? 'Sin confirmar ni descartar:' : 'Not confirmed either way:'}{' '}
            {g.unsure.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={devicePathIn(d, lang, translations)}>{d.data.name}</a>
              </>
            ))}.
          </p>
        )}
      </section>
    ))
  }

  <p class="muted">
    {es ? 'Otras plataformas:' : 'Other platforms:'}{' '}
    {
      otherLinks.map(({ e, href }, i) => (
        <>
          {i > 0 && ' · '}
          <a href={href}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

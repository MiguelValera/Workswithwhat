---
// "Devices that work with <ecosystem>": every market (/works-with/apple-home/, one table per
// market) or one market (/us/works-with/apple-home/).
import Base from '../../layouts/Base.astro';
import Refs from '../Refs.astro';
import Status from '../Status.astro';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  RADIO_LABELS,
  devicePath,
  ecosystemSlug,
  getPublishedDevices,
  categoryPhrase,
  type Device,
  worksWith,
  type Ecosystem,
} from '../../lib/devices';
import { CATEGORIES } from '../../lib/categories';
import { byMarket, marketOf, regionPath, type Market } from '../../lib/markets';

interface Props {
  eco: Ecosystem;
  market?: Market;
}
const { eco, market } = Astro.props;
const label = ECOSYSTEM_LABELS[eco];
const all = (await getPublishedDevices()).filter((d) => !market || marketOf(d) === market);
const path = market ? `/${market.key}/works-with/${ecosystemSlug(eco)}/` : `/works-with/${ecosystemSlug(eco)}/`;
// in a region page every table is one market already; elsewhere split each category by market
const split = (list: Device[]) => (market ? [{ market, devices: list }] : byMarket(list));
const otherLinks = await Promise.all(
  ECOSYSTEMS.filter((e) => e !== eco).map(async (e) => {
    const global = `/works-with/${ecosystemSlug(e)}/`;
    return { e, href: (market && (await regionPath(market, global))) || global };
  }),
);
const yes = all.filter((d) => worksWith(d, eco));
const viaMatter = yes.filter((d) => d.data.compatibility[eco].status === 'matter').length;
const groups = CATEGORIES.map((cat) => ({
  cat,
  yes: yes.filter((d) => d.data.category === cat.key),
  unsure: all.filter((d) => d.data.category === cat.key && d.data.compatibility[eco].status === 'unknown'),
  total: all.filter((d) => d.data.category === cat.key).length,
})).filter((g) => g.total > 0);
const { short: what, long: whatLong } = categoryPhrase(groups.map((g) => g.cat.plural));
const What = what.replace(/^./, (c) => c.toUpperCase());

// General, stable facts about how devices reach each platform. Device-specific
// claims stay in the device records, where they are sourced.
const HOW: Record<Ecosystem, string[]> = {
  apple_home: [
    'A device reaches Apple Home in one of two ways: it supports HomeKit directly, or it is Matter-certified and you add it with the Home app\'s Matter pairing.',
    'Automations and remote control need an Apple home hub (an Apple TV or a HomePod). Thread devices also need a Thread border router, which recent HomePod and Apple TV models include.',
  ],
  google_home: [
    'Devices connect to Google Home through the brand\'s own account linking (cloud to cloud) or through Matter.',
    'Matter needs a Google device that acts as a Matter hub, such as a Nest speaker or display. Thread devices also need a Google device that works as a Thread border router.',
  ],
  alexa: [
    'Devices connect to Alexa through the brand\'s Alexa skill (cloud to cloud) or through Matter.',
    'Matter needs an Echo device that works as a Matter controller, and Thread devices need an Echo that is also a Thread border router.',
  ],
  smartthings: [
    'Devices reach SmartThings through a cloud-to-cloud integration, through Matter, or as Zigbee devices paired to a SmartThings hub.',
    'Matter and Zigbee devices need a SmartThings hub. Some Samsung TVs and appliances can act as one.',
  ],
  home_assistant: [
    'Home Assistant connects to devices through brand integrations (many of them local), through its Matter integration, or through a Zigbee coordinator.',
    'Local integrations keep working without the internet, which is why we note local control on each device.',
  ],
};

const title = market ? `${What} that work with ${label} in ${market.phrase}` : `${What} that work with ${label}`;
const description = `${yes.length} ${whatLong} ${market ? `for ${market.phrase} ` : ''}confirmed to work with ${label}${viaMatter ? `, ${viaMatter} of them via Matter` : ''}. See which need a hub, and check the source for each one.`;
---

<Base
  title={title}
  description={description}
  crumbs={
    market
      ? [
          { name: market.label, path: `/${market.key}/` },
          { name: label, path },
        ]
      : [
          { name: 'By ecosystem', path: '/works-with/' },
          { name: label, path },
        ]
  }
>
  <h1>{title}</h1>
  <p class="lede">
    {yes.length} of the {all.length} devices we've checked{market && ` for ${market.phrase}`} work with {label}.
    {viaMatter > 0 && ` ${viaMatter} connect through Matter rather than a brand integration.`}
  </p>
  <nav class="toc" aria-label="On this page">
    <span class="toc-label">Jump to:</span>
    {groups.map((g) => <a href={`#${g.cat.path}`}>{g.cat.label} ({g.yes.length})</a>)}
    <a href="#how">How devices connect</a>
  </nav>
  <h2 id="how">How devices connect to {label}</h2>
  {HOW[eco].map((p) => <p>{p}</p>)}

  {
    groups.map((g) => (
      <section aria-labelledby={g.cat.path}>
        <h2 id={g.cat.path}>{g.cat.label} that work with {label}</h2>
        {g.yes.length > 0 ? (
          split(g.yes).map((m) => (
          <>
          {!market && <h3 id={`${g.cat.path}-${m.market.key}`}>{m.market.label} ({m.devices.length})</h3>}
          <div class="table-scroll">
            <table role="table" class="stack pair">
              <thead role="rowgroup">
                <tr role="row"><th role="columnheader" scope="col">Device</th><th role="columnheader" scope="col">How</th><th role="columnheader" scope="col">Radio</th><th role="columnheader" scope="col">Notes</th></tr>
              </thead>
              <tbody role="rowgroup">
                {m.devices.map((d) => {
                  const c = d.data.compatibility[eco];
                  return (
                    <tr role="row">
                      <th role="rowheader" scope="row" class="name">
                        <a href={devicePath(d)}>{d.data.name}</a>
                        <span class="note">{d.data.model} · {d.data.regions.join('/')}</span>
                      </th>
                      <td role="cell" data-label="How"><Status status={c.status} via={c.via} /></td>
                      <td role="cell" data-label="Radio">{(d.data.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || '—'}</td>
                      <td role="cell" class="wide">{c.note}<Refs ids={c.sources} all={d.data.sources} base={devicePath(d)} /></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          </>
          ))
        ) : (
          <p>None of the {g.cat.plural} we've checked so far are confirmed for {label}.</p>
        )}
        {g.unsure.length > 0 && (
          <p class="muted small">
            Not confirmed either way:{' '}
            {g.unsure.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={devicePath(d)}>{d.data.name}</a>
              </>
            ))}.
          </p>
        )}
      </section>
    ))
  }

  <p class="muted">
    Other platforms:{' '}
    {
      otherLinks.map(({ e, href }, i) => (
        <>
          {i > 0 && ' · '}
          <a href={href}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

---
// Region home (/us/, /eu/, /uk/ and /es/us/ …): what we've checked for one market, with links to its pages.
import Base from '../../layouts/Base.astro';
import DeviceCard from '../DeviceCard.astro';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, ecosystemPath, type Device } from '../../lib/devices';
import { CATEGORIES, catText } from '../../lib/categories';
import { getRegionPages, marketText, type Market } from '../../lib/markets';
import { pick, capitalize, langOf, localize } from '../../i18n/lang';

interface Props {
  market: Market;
  devices: Device[];
}
const { market, devices } = Astro.props;
const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const T = pick(lang);
const L = (p: string) => localize(p, lang);
const mt = marketText(market, lang);
const paths = new Set((await getRegionPages()).map((p) => p.path));
// a category with too few devices for its own region page links to its section on the full chart
const cats = CATEGORIES.map((c) => {
  const n = devices.filter((d) => d.data.category === c.key).length;
  const own = `/${market.key}/${c.path}/`;
  return { c, n, href: paths.has(own) ? own : `/${c.path}/#${market.key}` };
}).filter((x) => x.n > 0);
const platforms = [
  ...ECOSYSTEMS.map((e) => ({ name: ECOSYSTEM_LABELS[e], href: `/${market.key}${ecosystemPath(e)}` })),
  { name: 'Matter', href: `/${market.key}/works-with/matter/` },
].filter((p) => paths.has(p.href));
const recent = [...devices].sort((a, b) => (b.data.verifiedAt ?? '').localeCompare(a.data.verifiedAt ?? '')).slice(0, 6);
const title = T({ en: `Smart home compatibility for ${market.phrase}`, es: `Compatibilidad domótica para ${mt.phrase}` });
const description = es
  ? `${devices.length} dispositivos domóticos a la venta en ${mt.phrase}, comprobados con Apple Home, Google Home, Alexa, SmartThings y Home Assistant. Cada respuesta enlaza a su fuente.`
  : `${devices.length} smart home devices sold in ${market.phrase}, checked for Apple Home, Google Home, Alexa, SmartThings and Home Assistant. Every answer links to its source.`;
---

<Base title={title} description={description} crumbs={[{ name: mt.label, path: `/${market.key}/` }]}>
  <h1>{capitalize(title)}</h1>
  {
    es ? (
      <p class="lede">
        {devices.length} dispositivos a la venta en {mt.phrase}, cada uno comprobado con fuentes del fabricante y de
        certificación. Los modelos de otras regiones no aparecen, porque los enchufes, las radios y las certificaciones
        suelen cambiar entre ellas.
      </p>
    ) : (
      <p class="lede">
        {devices.length} devices sold in {market.phrase}, each checked against manufacturer and certification sources.
        Models for other regions are left out, because plugs, radios and certifications often differ between them.
      </p>
    )
  }
  <ul class="cards cats">
    {
      cats.map(({ c, n, href }) => (
        <li class="card">
          <h2><a href={L(href)}>{catText(c, lang).label}</a></h2>
          <div class="muted">{n} {T({ en: `for ${market.phrase}`, es: `para ${mt.phrase}` })}</div>
        </li>
      ))
    }
  </ul>
  {
    platforms.length > 0 && (
      <div class="callout jump">
        <p class="toc">
          <span class="toc-label">{T({ en: `By platform, ${market.label} only:`, es: `Por plataforma, solo ${mt.label}:` })}</span>
          {platforms.map((p) => <a href={L(p.href)}>{p.name}</a>)}
        </p>
      </div>
    )
  }
  <h2>{T({ en: `Recently checked for ${market.phrase}`, es: `Comprobados recientemente para ${mt.phrase}` })}</h2>
  <ul class="cards">
    {recent.map((d) => <DeviceCard device={d} />)}
  </ul>
</Base>

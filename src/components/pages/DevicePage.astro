---
// A device page, in English (/smart-plugs/<slug>/) or Spanish (/es/enchufes-inteligentes/<slug>/).
import Base from '../../layouts/Base.astro';
import Refs from '../Refs.astro';
import Status from '../Status.astro';
import DeviceCard from '../DeviceCard.astro';
import { catText, categoryOf, specFacts } from '../../lib/categories';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  answerFor,
  deviceText,
  devicePathIn,
  deviceTitle,
  ecosystemPath,
  ecosystemSlug,
  formatDate,
  getTranslations,
  langsFor,
  listJoin,
  matterText as matterWords,
  nameWithModel,
  radioList,
  worksWith,
  yesNoText,
  type Device,
} from '../../lib/devices';
import { marketChartPath, marketOf, marketText } from '../../lib/markets';
import { hubFor, devicesViaHub } from '../../lib/hubs';
import { comparePath, comparisonsFor } from '../../lib/compare';
import { CATEGORIES } from '../../lib/categories';
import { HTML_LANG, pick, capitalize, langOf, localize } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  device: Device;
  devices: Device[];
}
const { device, devices } = Astro.props;
const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const T = pick(lang);
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const translations = await getTranslations(lang);
const langs = await langsFor(device);
const words = deviceText(device, lang, translations.get(device.id));
const d = device.data;
const src = d.sources;
const cat = categoryOf(d);
const c = catText(cat, lang);
const specs = specFacts(d, lang, words.values);
const pagePath = `/${cat.path}/${device.id}/`;

const works = ECOSYSTEMS.filter((e) => worksWith(device, e)).map((e) => ECOSYSTEM_LABELS[e]);

const title = deviceTitle(device, lang);
const named = nameWithModel(device);
const description = es
  ? works.length
    ? `${named} funciona con ${listJoin(works, lang)}. Tipo de conexión, necesidad de hub y especificaciones, cada dato con su fuente.`
    : `Compatibilidad de ${named} con Apple Home, Google Home, Alexa, SmartThings y Home Assistant, con fuentes.`
  : works.length
    ? `${named} works with ${listJoin(works)}. Connection type, hub needs and specs, each linked to its source.`
    : `${named} compatibility with Apple Home, Google Home, Alexa, SmartThings and Home Assistant, with sources.`;

const yesNo = (v: boolean | null) => yesNoText(v, lang);
const radios = radioList(d.radios.value, lang) || t.unconfirmed;
const matterText = matterWords(device, lang);

const market = marketOf(device);
const mt = marketText(market, lang);
// the region chart if the market has one, else the market's section on the full chart
const marketChart = L(await marketChartPath(market, cat));
const variants = (d.variants ?? [])
  .map((v) => devices.find((o) => o.id === v))
  .filter((o): o is Device => Boolean(o))
  .map((o) => ({ device: o, market: marketText(marketOf(o), lang) }));

const related = devices
  .filter((o) => o.id !== device.id && o.data.category === d.category && marketOf(o) === market)
  .slice(0, 3);

const comparisons = await comparisonsFor(device);

// a hub page lists what connects through it, grouped by category
const viaHub = d.category === 'smart-hub' ? devicesViaHub(device, devices) : [];
const viaHubGroups = CATEGORIES.map((k) => ({ cat: k, items: viaHub.filter((o) => o.data.category === k.key) })).filter((g) => g.items.length);

const faq = ECOSYSTEMS.map((e) => ({
  eco: e,
  q: T({ en: `Does the ${d.name} work with ${ECOSYSTEM_LABELS[e]}?`, es: `¿Funciona ${d.name} con ${ECOSYSTEM_LABELS[e]}?` }),
  a: answerFor(device, e, lang, words),
}));
const KIND_ES: Record<string, string> = { manufacturer: 'fabricante', certification: 'certificación', ecosystem: 'ecosistema', retailer: 'tienda', review: 'análisis' };
const other = es ? (c.gender === 'f' ? 'Otras' : 'Otros') : 'Other';
const similar = es ? (c.gender === 'f' ? 'similares' : 'similares') : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    inLanguage: HTML_LANG[lang],
    dateModified: d.updatedAt,
    ...(d.verifiedAt && { lastReviewed: d.verifiedAt }),
    mainEntity: {
      '@type': 'Product',
      name: d.name,
      model: d.model,
      brand: { '@type': 'Brand', name: d.brand },
      category: capitalize(c.singular),
      description: words.summary,
      url: d.officialUrl,
    },
  },
];
---

<Base
  title={title}
  description={description}
  ogType="article"
  crumbs={[
    { name: c.label, path: `/${cat.path}/` },
    { name: d.name, path: pagePath },
  ]}
  alternates={langs.length > 1}
  langs={langs}
  jsonLd={jsonLd}
>
  <article>
    {d.status === 'draft' && <p class="badge s-hub">Draft, not published (visible in dev only)</p>}
    <h1>{T({ en: `${d.name}: what it works with`, es: `${d.name}: con qué funciona` })}</h1>
    <p class="muted">
      {d.brand} · {T({ en: 'model', es: 'modelo' })} {d.model} · <a class="badge region" href={marketChart}>{T({ en: `For ${market.phrase}`, es: `Para ${mt.phrase}` })}</a>
      {d.regions.length > 1 && <> ({d.regions.join(', ')})</>}
    </p>
    {
      variants.length > 0 && (
        <p class="variants">
          {T({ en: 'Other regions:', es: 'Otras regiones:' })}{' '}
          {variants.map((v, i) => (
            <>
              {i > 0 && ' · '}
              <a href={devicePathIn(v.device, lang, translations)}>{v.device.data.name}</a> ({v.market.label})
            </>
          ))}
        </p>
      )
    }
    <ul class="glance" aria-label={T({ en: 'Compatibility at a glance', es: 'Compatibilidad de un vistazo' })}>
      <li>
        <a href="#compat-matter"><span class="glance-eco">Matter</span> <span class={`badge s-${d.matter.certified}`}>{matterText}</span></a>
      </li>
      {
        ECOSYSTEMS.map((e) => (
          <li>
            <a href={`#compat-${ecosystemSlug(e)}`}>
              <span class="glance-eco">{ECOSYSTEM_LABELS[e]}</span> <Status status={d.compatibility[e].status} via={words.via(e)} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="lede">{words.summary}</p>
    {
      d.verifiedAt && (
        <p class="verified">
          {T({ en: `Checked against ${src.length} sources on `, es: `Comprobado con ${src.length} fuentes el ` })}
          <time datetime={d.verifiedAt}>{formatDate(d.verifiedAt, lang)}</time>
        </p>
      )
    }

    <nav class="toc" aria-label={T({ en: 'On this page', es: 'En esta página' })}>
      <span class="toc-label">{T({ en: 'On this page:', es: 'En esta página:' })}</span>
      <a href="#compat">{T({ en: 'Compatibility', es: 'Compatibilidad' })}</a>
      <a href="#specs">{T({ en: 'Specs', es: 'Especificaciones' })}</a>
      {words.caveats.length > 0 && <a href="#before-you-buy">{T({ en: 'Before you buy', es: 'Antes de comprar' })}</a>}
      <a href="#quick-answers">{T({ en: 'Quick answers', es: 'Respuestas rápidas' })}</a>
      <a href="#sources">{T({ en: 'Sources', es: 'Fuentes' })}</a>
      {viaHub.length > 0 && <a href="#works-through">{T({ en: 'What connects through it', es: 'Qué se conecta a través de él' })}</a>}
      {comparisons.length > 0 && <a href="#compare">{T({ en: 'Compare', es: 'Comparar' })}</a>}
      {related.length > 0 && <a href="#related">{T({ en: `Similar ${cat.plural}`, es: `${capitalize(c.plural)} ${similar}` })}</a>}
    </nav>

    <h2 id="compat">{T({ en: 'Ecosystem compatibility', es: 'Compatibilidad con cada ecosistema' })}</h2>
    <div class="table-scroll">
      <table role="table" class="stack kv">
        <thead role="rowgroup">
          <tr role="row"><th role="columnheader" scope="col">{T({ en: 'Platform', es: 'Plataforma' })}</th><th role="columnheader" scope="col">{T({ en: 'Works?', es: '¿Funciona?' })}</th><th role="columnheader" scope="col">{T({ en: 'Details', es: 'Detalles' })}</th></tr>
        </thead>
        <tbody role="rowgroup">
          <tr role="row" id="compat-matter">
            <th role="rowheader" scope="row">Matter</th>
            <td role="cell"><span class={`badge s-${d.matter.certified}`}>{matterText}</span></td>
            <td role="cell" class="wide">
              {words.note('matter', d.matter.note)}<Refs ids={d.matter.sources} all={src} />
              {d.matter.certified && <> <a href={L('/works-with/matter/')}>{T({ en: `Other Matter ${cat.plural}`, es: `${other} ${c.plural} con Matter` })}</a></>}
            </td>
          </tr>
          {
            ECOSYSTEMS.map((e) => {
              const cp = d.compatibility[e];
              return (
                <tr role="row" id={`compat-${ecosystemSlug(e)}`}>
                  <th role="rowheader" scope="row">{ECOSYSTEM_LABELS[e]}</th>
                  <td role="cell"><Status status={cp.status} via={words.via(e)} /></td>
                  <td role="cell" class="wide">
                    {words.compatNote(e)}<Refs ids={cp.sources} all={src} />
                    {(() => {
                      const hub = cp.status === 'hub' ? hubFor(cp.via, device, devices) : undefined;
                      return hub && <> <a href={devicePathIn(hub, lang, translations)}>{T({ en: `About the ${hub.data.name}`, es: `Más sobre el ${hub.data.name}` })}</a></>;
                    })()}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    {
      es ? (
        <p class="muted small">
          «Vía Matter» significa que lo añades con el controlador Matter de esa plataforma en lugar de una skill o app de la marca.
          «Sin confirmar» significa que no hemos encontrado ninguna fuente oficial que lo confirme o lo descarte.{' '}
          <a href={L('/methodology/')}>Cómo verificamos</a>.
        </p>
      ) : (
        <p class="muted small">
          “Via Matter” means you add it with that platform's Matter controller instead of a brand skill or app.
          “Unconfirmed” means we couldn't find an official source either way.{' '}
          <a href="/methodology/">How we verify</a>.
        </p>
      )
    }

    <h2 id="specs">{T({ en: 'Specs that matter for setup', es: 'Especificaciones clave para la instalación' })}</h2>
    <dl class="facts">
      <div><dt>{t.radio}</dt><dd>{radios}<Refs ids={d.radios.sources} all={src} /></dd></div>
      <div><dt>{T({ en: 'Hub required', es: 'Necesita hub' })}</dt><dd>{yesNo(d.hubRequired.value)}<Refs ids={d.hubRequired.sources} all={src} /></dd></div>
      <div><dt>{T({ en: 'Local control', es: 'Control local' })}</dt><dd>{yesNo(d.localControl.value)}<Refs ids={d.localControl.sources} all={src} /></dd></div>
      {specs.map((s) => <div><dt>{s.label}</dt><dd>{s.text}<Refs ids={s.fact.sources} all={src} /></dd></div>)}
    </dl>
    {
      [d.hubRequired, d.localControl, d.radios, ...specs.map((s) => s.fact)].some((f) => f.note) && (
        <ul class="muted small">
          {d.radios.note && <li>{t.radio}: {words.note('radios', d.radios.note)}</li>}
          {d.hubRequired.note && <li>Hub: {words.note('hubRequired', d.hubRequired.note)}</li>}
          {d.localControl.note && <li>{T({ en: 'Local control', es: 'Control local' })}: {words.note('localControl', d.localControl.note)}</li>}
          {specs.map((s) => s.fact.note && <li>{s.label}: {words.note(s.key, s.fact.note)}</li>)}
        </ul>
      )
    }

    {
      words.caveats.length > 0 && (
        <>
          <h2 id="before-you-buy">{T({ en: 'Before you buy', es: 'Antes de comprar' })}</h2>
          <ul class="caveats">
            {words.caveats.map((cv) => <li>{cv}</li>)}
          </ul>
        </>
      )
    }

    <h2 id="quick-answers">{T({ en: 'Quick answers', es: 'Respuestas rápidas' })}</h2>
    <dl class="faq">
      {
        faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>
              {f.a}{' '}
              {worksWith(device, f.eco) && (
                <a href={L(ecosystemPath(f.eco))}>{T({ en: `More ${cat.plural} for ${ECOSYSTEM_LABELS[f.eco]}`, es: `Más ${c.plural} para ${ECOSYSTEM_LABELS[f.eco]}` })}</a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 id="sources">{T({ en: 'Sources', es: 'Fuentes' })}</h2>
    <ol class="sources">
      {
        src.map((s) => (
          <li id={`src-${s.id}`}>
            <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> — {s.publisher}{' '}
            <span class="kind">{es ? KIND_ES[s.kind] : s.kind}</span> <span class="muted">· {T({ en: 'accessed', es: 'consultada el' })} {formatDate(s.accessed, lang)}</span>
          </li>
        ))
      }
    </ol>
    <p class="muted">
      {T({ en: 'Official product page:', es: 'Página oficial del producto:' })} <a href={d.officialUrl} rel="nofollow noopener">{new URL(d.officialUrl).hostname}</a>
    </p>
  </article>

  {
    viaHub.length > 0 && (
      <section aria-labelledby="works-through">
        <h2 id="works-through">{T({ en: `Devices that work through the ${d.name}`, es: `Dispositivos que funcionan a través del ${d.name}` })}</h2>
        <p class="muted small">
          {es
            ? 'Fichas verificadas que necesitan este hub para llegar al menos a un ecosistema. Cada ficha dice para cuáles.'
            : 'Verified records that need this hub to reach at least one ecosystem. Each page says which ones.'}
        </p>
        {viaHubGroups.map((g) => (
          <>
            <h3>{catText(g.cat, lang).label}</h3>
            <ul class="link-list">
              {g.items.map((o) => <li><a href={devicePathIn(o, lang, translations)}>{o.data.name}</a></li>)}
            </ul>
          </>
        ))}
      </section>
    )
  }

  {
    comparisons.length > 0 && (
      <section aria-labelledby="compare">
        <h2 id="compare">{T({ en: `Compare the ${d.name}`, es: `Compara ${d.name}` })}</h2>
        <ul class="link-list">
          {comparisons.map((x) => <li><a href={L(comparePath(x))}>{T({ en: `vs ${x.other.data.name}`, es: `frente a ${x.other.data.name}` })}</a></li>)}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related">{T({ en: `Other ${cat.plural} for ${market.phrase}`, es: `${other} ${c.plural} para ${mt.phrase}` })}</h2>
        <ul class="cards">
          {related.map((r) => <DeviceCard device={r} />)}
        </ul>
      </section>
    )
  }
</Base>

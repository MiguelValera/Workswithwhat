---
// A device page, in English (/smart-plugs/<slug>/) or Spanish (/es/enchufes-inteligentes/<slug>/).
import Base from '../../layouts/Base.astro';
import Refs from '../Refs.astro';
import Status from '../Status.astro';
import DeviceCard from '../DeviceCard.astro';
import { catText, categoryOf, specFacts } from '../../lib/categories';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  answerFor,
  deviceText,
  devicePathIn,
  deviceTitle,
  ecosystemSlug,
  formatDate,
  getTranslations,
  listJoin,
  radioList,
  worksWith,
  type Device,
} from '../../lib/devices';
import { marketOf, marketText, regionPath } from '../../lib/markets';
import { hubFor, devicesViaHub } from '../../lib/hubs';
import { CATEGORIES } from '../../lib/categories';
import { langOf, localize } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  device: Device;
  devices: Device[];
}
const { device, devices } = Astro.props;
const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const translations = await getTranslations();
const words = deviceText(device, lang, translations.get(device.id));
const d = device.data;
const src = d.sources;
const cat = categoryOf(d);
const c = catText(cat, lang);
const specs = specFacts(d, lang, words.values);
const pagePath = `/${cat.path}/${device.id}/`;

const works = ECOSYSTEMS.filter((e) => worksWith(device, e)).map((e) => ECOSYSTEM_LABELS[e]);

const title = deviceTitle(device, lang);
const description = es
  ? works.length
    ? `${d.name} (${d.model}) funciona con ${listJoin(works, lang)}. Tipo de conexión, necesidad de hub y especificaciones, cada dato con su fuente.`
    : `Compatibilidad de ${d.name} (${d.model}) con Apple Home, Google Home, Alexa, SmartThings y Home Assistant, con fuentes.`
  : works.length
    ? `${d.name} (${d.model}) works with ${listJoin(works)}. Connection type, hub needs and specs, each linked to its source.`
    : `${d.name} (${d.model}) compatibility with Apple Home, Google Home, Alexa, SmartThings and Home Assistant, with sources.`;

const yesNo = (v: boolean | null) => (v === null ? t.unconfirmed : v ? t.yes : t.no);
const radios = radioList(d.radios.value, lang) || t.unconfirmed;
const transport = d.matter.transport === 'wifi' ? (es ? 'wifi' : 'Wi-Fi') : d.matter.transport === 'thread' ? 'Thread' : 'Ethernet';
const matterText =
  d.matter.certified === null ? t.unconfirmed : d.matter.certified ? (es ? `Sí, por ${transport}` : `Yes, over ${transport}`) : t.no;

const market = marketOf(device);
const mt = marketText(market, lang);
// the region chart if the market has one, else the market's section on the full chart
const marketChart = L((await regionPath(market, `/${cat.path}/`)) ?? `/${cat.path}/#${market.key}`);
const variants = (d.variants ?? [])
  .map((v) => devices.find((o) => o.id === v))
  .filter((o): o is Device => Boolean(o))
  .map((o) => ({ device: o, market: marketText(marketOf(o), lang) }));

const related = devices
  .filter((o) => o.id !== device.id && o.data.category === d.category && marketOf(o) === market)
  .slice(0, 3);

// a hub page lists what connects through it, grouped by category
const viaHub = d.category === 'smart-hub' ? devicesViaHub(device, devices) : [];
const viaHubGroups = CATEGORIES.map((k) => ({ cat: k, items: viaHub.filter((o) => o.data.category === k.key) })).filter((g) => g.items.length);

const faq = ECOSYSTEMS.map((e) => ({
  eco: e,
  q: es ? `¿Funciona ${d.name} con ${ECOSYSTEM_LABELS[e]}?` : `Does the ${d.name} work with ${ECOSYSTEM_LABELS[e]}?`,
  a: answerFor(device, e, lang, words),
}));
const KIND_ES: Record<string, string> = { manufacturer: 'fabricante', certification: 'certificación', ecosystem: 'ecosistema', retailer: 'tienda', review: 'análisis' };
const other = es ? (c.gender === 'f' ? 'Otras' : 'Otros') : 'Other';
const similar = es ? (c.gender === 'f' ? 'similares' : 'similares') : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    inLanguage: es ? 'es-ES' : 'en',
    dateModified: d.updatedAt,
    ...(d.verifiedAt && { lastReviewed: d.verifiedAt }),
    mainEntity: {
      '@type': 'Product',
      name: d.name,
      model: d.model,
      brand: { '@type': 'Brand', name: d.brand },
      category: c.singular.replace(/^./, (x) => x.toUpperCase()),
      description: words.summary,
      url: d.officialUrl,
    },
  },
];
---

<Base
  title={title}
  description={description}
  ogType="article"
  crumbs={[
    { name: c.label, path: `/${cat.path}/` },
    { name: d.name, path: pagePath },
  ]}
  alternates={translations.has(device.id)}
  jsonLd={jsonLd}
>
  <article>
    {d.status === 'draft' && <p class="badge s-hub">Draft, not published (visible in dev only)</p>}
    <h1>{es ? `${d.name}: con qué funciona` : `${d.name}: what it works with`}</h1>
    <p class="muted">
      {d.brand} · {es ? 'modelo' : 'model'} {d.model} · <a class="badge region" href={marketChart}>{es ? `Para ${mt.phrase}` : `For ${market.phrase}`}</a>
      {d.regions.length > 1 && <> ({d.regions.join(', ')})</>}
    </p>
    {
      variants.length > 0 && (
        <p class="variants">
          {es ? 'Otras regiones:' : 'Other regions:'}{' '}
          {variants.map((v, i) => (
            <>
              {i > 0 && ' · '}
              <a href={devicePathIn(v.device, lang, translations)}>{v.device.data.name}</a> ({v.market.label})
            </>
          ))}
        </p>
      )
    }
    <ul class="glance" aria-label={es ? 'Compatibilidad de un vistazo' : 'Compatibility at a glance'}>
      <li>
        <a href="#compat-matter"><span class="glance-eco">Matter</span> <span class={`badge s-${d.matter.certified}`}>{matterText}</span></a>
      </li>
      {
        ECOSYSTEMS.map((e) => (
          <li>
            <a href={`#compat-${ecosystemSlug(e)}`}>
              <span class="glance-eco">{ECOSYSTEM_LABELS[e]}</span> <Status status={d.compatibility[e].status} via={words.via(e)} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="lede">{words.summary}</p>
    {
      d.verifiedAt && (
        <p class="verified">
          {es ? `Comprobado con ${src.length} fuentes el ` : `Checked against ${src.length} sources on `}
          <time datetime={d.verifiedAt}>{formatDate(d.verifiedAt, lang)}</time>
        </p>
      )
    }

    <nav class="toc" aria-label={es ? 'En esta página' : 'On this page'}>
      <span class="toc-label">{es ? 'En esta página:' : 'On this page:'}</span>
      <a href="#compat">{es ? 'Compatibilidad' : 'Compatibility'}</a>
      <a href="#specs">{es ? 'Especificaciones' : 'Specs'}</a>
      {words.caveats.length > 0 && <a href="#before-you-buy">{es ? 'Antes de comprar' : 'Before you buy'}</a>}
      <a href="#quick-answers">{es ? 'Respuestas rápidas' : 'Quick answers'}</a>
      <a href="#sources">{es ? 'Fuentes' : 'Sources'}</a>
      {viaHub.length > 0 && <a href="#works-through">{es ? 'Qué se conecta a través de él' : 'What connects through it'}</a>}
      {related.length > 0 && <a href="#related">{es ? `${c.plural.replace(/^./, (x) => x.toUpperCase())} ${similar}` : `Similar ${cat.plural}`}</a>}
    </nav>

    <h2 id="compat">{es ? 'Compatibilidad con cada ecosistema' : 'Ecosystem compatibility'}</h2>
    <div class="table-scroll">
      <table role="table" class="stack kv">
        <thead role="rowgroup">
          <tr role="row"><th role="columnheader" scope="col">{es ? 'Plataforma' : 'Platform'}</th><th role="columnheader" scope="col">{es ? '¿Funciona?' : 'Works?'}</th><th role="columnheader" scope="col">{es ? 'Detalles' : 'Details'}</th></tr>
        </thead>
        <tbody role="rowgroup">
          <tr role="row" id="compat-matter">
            <th role="rowheader" scope="row">Matter</th>
            <td role="cell"><span class={`badge s-${d.matter.certified}`}>{matterText}</span></td>
            <td role="cell" class="wide">
              {words.note('matter', d.matter.note)}<Refs ids={d.matter.sources} all={src} />
              {d.matter.certified && <> <a href={L('/works-with/matter/')}>{es ? `${other} ${c.plural} con Matter` : `Other Matter ${cat.plural}`}</a></>}
            </td>
          </tr>
          {
            ECOSYSTEMS.map((e) => {
              const cp = d.compatibility[e];
              return (
                <tr role="row" id={`compat-${ecosystemSlug(e)}`}>
                  <th role="rowheader" scope="row">{ECOSYSTEM_LABELS[e]}</th>
                  <td role="cell"><Status status={cp.status} via={words.via(e)} /></td>
                  <td role="cell" class="wide">
                    {words.compatNote(e)}<Refs ids={cp.sources} all={src} />
                    {(() => {
                      const hub = cp.status === 'hub' ? hubFor(cp.via, device, devices) : undefined;
                      return hub && <> <a href={devicePathIn(hub, lang, translations)}>{es ? `Más sobre el ${hub.data.name}` : `About the ${hub.data.name}`}</a></>;
                    })()}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    {
      es ? (
        <p class="muted small">
          «Vía Matter» significa que lo añades con el controlador Matter de esa plataforma en lugar de una skill o app de la marca.
          «Sin confirmar» significa que no hemos encontrado ninguna fuente oficial que lo confirme o lo descarte.{' '}
          <a href={L('/methodology/')}>Cómo verificamos</a>.
        </p>
      ) : (
        <p class="muted small">
          “Via Matter” means you add it with that platform's Matter controller instead of a brand skill or app.
          “Unconfirmed” means we couldn't find an official source either way.{' '}
          <a href="/methodology/">How we verify</a>.
        </p>
      )
    }

    <h2 id="specs">{es ? 'Especificaciones clave para la instalación' : 'Specs that matter for setup'}</h2>
    <dl class="facts">
      <div><dt>{t.radio}</dt><dd>{radios}<Refs ids={d.radios.sources} all={src} /></dd></div>
      <div><dt>{es ? 'Necesita hub' : 'Hub required'}</dt><dd>{yesNo(d.hubRequired.value)}<Refs ids={d.hubRequired.sources} all={src} /></dd></div>
      <div><dt>{es ? 'Control local' : 'Local control'}</dt><dd>{yesNo(d.localControl.value)}<Refs ids={d.localControl.sources} all={src} /></dd></div>
      {specs.map((s) => <div><dt>{s.label}</dt><dd>{s.text}<Refs ids={s.fact.sources} all={src} /></dd></div>)}
    </dl>
    {
      [d.hubRequired, d.localControl, d.radios, ...specs.map((s) => s.fact)].some((f) => f.note) && (
        <ul class="muted small">
          {d.radios.note && <li>{t.radio}: {words.note('radios', d.radios.note)}</li>}
          {d.hubRequired.note && <li>Hub: {words.note('hubRequired', d.hubRequired.note)}</li>}
          {d.localControl.note && <li>{es ? 'Control local' : 'Local control'}: {words.note('localControl', d.localControl.note)}</li>}
          {specs.map((s) => s.fact.note && <li>{s.label}: {words.note(s.key, s.fact.note)}</li>)}
        </ul>
      )
    }

    {
      words.caveats.length > 0 && (
        <>
          <h2 id="before-you-buy">{es ? 'Antes de comprar' : 'Before you buy'}</h2>
          <ul class="caveats">
            {words.caveats.map((cv) => <li>{cv}</li>)}
          </ul>
        </>
      )
    }

    <h2 id="quick-answers">{es ? 'Respuestas rápidas' : 'Quick answers'}</h2>
    <dl class="faq">
      {
        faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>
              {f.a}{' '}
              {worksWith(device, f.eco) && (
                <a href={L(`/works-with/${ecosystemSlug(f.eco)}/`)}>{es ? `Más ${c.plural} para ${ECOSYSTEM_LABELS[f.eco]}` : `More ${cat.plural} for ${ECOSYSTEM_LABELS[f.eco]}`}</a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 id="sources">{es ? 'Fuentes' : 'Sources'}</h2>
    <ol class="sources">
      {
        src.map((s) => (
          <li id={`src-${s.id}`}>
            <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> — {s.publisher}{' '}
            <span class="kind">{es ? KIND_ES[s.kind] : s.kind}</span> <span class="muted">· {es ? 'consultada el' : 'accessed'} {formatDate(s.accessed, lang)}</span>
          </li>
        ))
      }
    </ol>
    <p class="muted">
      {es ? 'Página oficial del producto:' : 'Official product page:'} <a href={d.officialUrl} rel="nofollow noopener">{new URL(d.officialUrl).hostname}</a>
    </p>
  </article>

  {
    viaHub.length > 0 && (
      <section aria-labelledby="works-through">
        <h2 id="works-through">{es ? `Dispositivos que funcionan a través del ${d.name}` : `Devices that work through the ${d.name}`}</h2>
        <p class="muted small">
          {es
            ? 'Fichas verificadas que necesitan este hub para llegar al menos a un ecosistema. Cada ficha dice para cuáles.'
            : 'Verified records that need this hub to reach at least one ecosystem. Each page says which ones.'}
        </p>
        {viaHubGroups.map((g) => (
          <>
            <h3>{catText(g.cat, lang).label}</h3>
            <ul class="link-list">
              {g.items.map((o) => <li><a href={devicePathIn(o, lang, translations)}>{o.data.name}</a></li>)}
            </ul>
          </>
        ))}
      </section>
    )
  }

  {
    related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related">{es ? `${other} ${c.plural} para ${mt.phrase}` : `Other ${cat.plural} for ${market.phrase}`}</h2>
        <ul class="cards">
          {related.map((r) => <DeviceCard device={r} />)}
        </ul>
      </section>
    )
  }
</Base>

---
import Base from '../../layouts/Base.astro';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, ecosystemSlug, getPublishedDevices, worksWith } from '../../lib/devices';
import { langOf, localize } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const all = await getPublishedDevices();
---

<Base
  title={es ? 'Dispositivos domóticos por ecosistema' : 'Smart home devices by ecosystem'}
  description={es
    ? 'Encuentra dispositivos domóticos compatibles con Apple Home, Google Home, Amazon Alexa, SmartThings o Home Assistant, con una fuente para cada respuesta.'
    : 'Find smart home devices that work with Apple Home, Google Home, Amazon Alexa, SmartThings or Home Assistant, with a source for every answer.'}
  crumbs={[{ name: t.navByEcosystem, path: '/works-with/' }]}
>
  <h1>{es ? 'Buscar por ecosistema' : 'Browse by ecosystem'}</h1>
  <p class="lede">{es ? 'Elige la plataforma que ya usas.' : 'Pick the platform you already use.'}</p>
  <ul class="cards">
    {
      ECOSYSTEMS.map((e) => (
        <li class="card">
          <h3><a href={L(`/works-with/${ecosystemSlug(e)}/`)}>{ECOSYSTEM_LABELS[e]}</a></h3>
          <div class="muted">{all.filter((d) => worksWith(d, e)).length} {es ? 'dispositivos compatibles' : 'compatible devices'}</div>
        </li>
      ))
    }
    <li class="card">
      <h3><a href={L('/works-with/matter/')}>Matter</a></h3>
      <div class="muted">{all.filter((d) => d.data.matter.certified).length} {es ? 'dispositivos con certificación Matter' : 'Matter-certified devices'}</div>
    </li>
  </ul>
</Base>

---
// Matter-certified devices: every market (/works-with/matter/) or one (/us/works-with/matter/).
import Base from '../../layouts/Base.astro';
import DeviceNameCell from '../DeviceNameCell.astro';
import Refs from '../Refs.astro';
import { deviceText, devicePathIn, getPublishedDevices, getTranslations, categoryPhrase, radioList, type Device } from '../../lib/devices';
import { CATEGORIES, catText, specFacts } from '../../lib/categories';
import { byMarket, marketOf, marketText, type Market } from '../../lib/markets';
import { capitalize, langOf } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  market?: Market;
}
const { market } = Astro.props;
const lang = langOf(Astro.url.pathname);
const es = lang === 'es';
const t = ui(lang);
const translations = await getTranslations();
const mt = market && marketText(market, lang);
const all = (await getPublishedDevices()).filter((d) => !market || marketOf(d) === market);
const path = market ? `/${market.key}/works-with/matter/` : '/works-with/matter/';
const split = (list: Device[]) => (market ? [{ market, devices: list }] : byMarket(list));
const matter = all.filter((d) => d.data.matter.certified);
const groups = CATEGORIES.map((cat) => {
  const list = matter.filter((d) => d.data.category === cat.key);
  return {
    cat,
    list,
    wifi: list.filter((d) => d.data.matter.transport === 'wifi'),
    thread: list.filter((d) => d.data.matter.transport === 'thread'),
  };
}).filter((g) => g.list.length > 0);
const { short: what, long: whatLong } = categoryPhrase(groups.map((g) => catText(g.cat, lang).plural), lang);

const title = es
  ? `${capitalize(what)} con Matter${mt ? ` para ${mt.phrase}` : ''}`
  : market
    ? `Matter ${what} for ${market.phrase}`
    : `Matter ${what}`;
const description = es
  ? `${matter.length} ${whatLong} con certificación Matter${mt ? ` para ${mt.phrase}` : ''}, separados por wifi y Thread, con lo que necesita cada uno para funcionar en Apple Home, Google Home, Alexa, SmartThings y Home Assistant.`
  : `${matter.length} Matter-certified ${whatLong}${market ? ` for ${market.phrase}` : ''}, split by Wi-Fi and Thread, with what each needs to work in Apple Home, Google Home, Alexa, SmartThings and Home Assistant.`;
const wifiN = groups.reduce((n, g) => n + g.wifi.length, 0);
const threadN = groups.reduce((n, g) => n + g.thread.length, 0);
---

<Base
  title={title}
  description={description}
  crumbs={
    market
      ? [
          { name: mt!.label, path: `/${market.key}/` },
          { name: 'Matter', path },
        ]
      : [
          { name: t.navByEcosystem, path: '/works-with/' },
          { name: 'Matter', path },
        ]
  }
>
  <h1>{capitalize(title)}</h1>
  {
    es ? (
      <p class="lede">
        {matter.length} de los {all.length} dispositivos que hemos comprobado tienen certificación Matter: {wifiN} por wifi y {threadN} por Thread.
      </p>
    ) : (
      <p class="lede">
        {matter.length} of the {all.length} devices we've checked are Matter-certified: {wifiN} over Wi-Fi and {threadN} over Thread.
      </p>
    )
  }

  <nav class="toc" aria-label={es ? 'En esta página' : 'On this page'}>
    <span class="toc-label">{t.jumpTo}</span>
    {
      groups.flatMap((g) => [
        g.wifi.length > 0 && <a href={`#${g.cat.path}-wifi`}>{catText(g.cat, lang).label} {es ? 'por wifi' : 'over Wi-Fi'} ({g.wifi.length})</a>,
        g.thread.length > 0 && <a href={`#${g.cat.path}-thread`}>{catText(g.cat, lang).label} {es ? 'por Thread' : 'over Thread'} ({g.thread.length})</a>,
      ])
    }
    <a href="#what-matter-means">{es ? 'Qué significa Matter' : 'What Matter means'}</a>
  </nav>
  {
    es ? (
      <>
        <h2 id="what-matter-means">Qué significa Matter para un dispositivo</h2>
        <p>
          Un dispositivo con certificación Matter se puede añadir a cualquier plataforma que actúe como controlador Matter,
          como Apple Home, Google Home, Alexa, SmartThings y Home Assistant, sin la skill ni la nube de la marca. También
          puedes compartirlo con varias plataformas a la vez.
        </p>
        <p>
          <strong>Los dispositivos wifi</strong> se conectan a tu red actual. <strong>Los dispositivos Thread</strong> usan una
          malla de bajo consumo y necesitan un router de borde Thread, que incluyen muchos altavoces inteligentes y
          reproductores multimedia recientes. En ambos casos, la plataforma a la que lo añadas necesita su propio hub Matter
          para las automatizaciones y el acceso remoto.
        </p>
      </>
    ) : (
      <>
        <h2 id="what-matter-means">What Matter means for a device</h2>
        <p>
          A Matter-certified device can be added to any platform that acts as a Matter controller, including Apple Home,
          Google Home, Alexa, SmartThings and Home Assistant, without the brand's own skill or cloud. You can also share
          it with more than one platform at once.
        </p>
        <p>
          <strong>Wi-Fi devices</strong> join your existing network. <strong>Thread devices</strong> use a low-power mesh and
          need a Thread border router, which many recent smart speakers and streaming boxes include. Either way, the
          platform you add it to needs its own Matter hub for automations and remote access.
        </p>
      </>
    )
  }

  {
    groups.map((g) =>
      [
        { label: es ? 'por wifi' : 'over Wi-Fi', list: g.wifi, id: `${g.cat.path}-wifi` },
        { label: es ? 'por Thread' : 'over Thread', list: g.thread, id: `${g.cat.path}-thread` },
      ].map(
        (tr) =>
          tr.list.length > 0 && (
            <>
              <h2 id={tr.id}>{es ? `${catText(g.cat, lang).label} con Matter ${tr.label}` : `Matter ${g.cat.plural} ${tr.label}`}</h2>
              {split(tr.list).map((m) => (
              <>
              {!market && <h3 id={`${tr.id}-${m.market.key}`}>{marketText(m.market, lang).label} ({m.devices.length})</h3>}
              <div class="table-scroll">
                <table role="table" class="stack pair">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th role="columnheader" scope="col">{t.device}</th>
                      <th role="columnheader" scope="col">{t.radios}</th>
                      <th role="columnheader" scope="col">{es ? g.cat.specs[0].labelEs : g.cat.specs[0].label}</th>
                      <th role="columnheader" scope="col">{t.notes}</th>
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    {m.devices.map((d) => {
                      const words = deviceText(d, lang, translations.get(d.id));
                      const href = devicePathIn(d, lang, translations);
                      const spec = specFacts(d.data, lang, words.values)[0];
                      return (
                        <tr role="row">
                          <DeviceNameCell device={d} href={href} />
                          <td role="cell" data-label={t.radios}>{radioList(d.data.radios.value, lang) || '—'}</td>
                          <td role="cell" data-label={spec.label}>{spec.text}</td>
                          <td role="cell" class="wide">{words.note('matter', d.data.matter.note)}<Refs ids={d.data.matter.sources} all={d.data.sources} base={href} /></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              </>
              ))}
            </>
          ),
      ),
    )
  }

  <p class="muted small">
    {
      es
        ? 'Solo aparecen dispositivos con certificación Matter propia. Los que llegan a Matter a través de un puente (como un dispositivo Zigbee detrás de un hub) están en las tablas completas.'
        : 'Only devices that are Matter-certified themselves are listed. Devices that reach Matter through a bridge (such as a Zigbee device behind a hub) are on the full charts.'
    }
  </p>
</Base>

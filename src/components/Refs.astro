---
// Footnote-style links from a claim to the device's source list.
interface Props {
  ids: string[];
  all: { id: string }[];
  /** page holding the source list, when it isn't the current page */
  base?: string;
}
import { langOf } from '../i18n/lang';
import { ui } from '../i18n/ui';
const { ids, all, base = '' } = Astro.props;
const t = ui(langOf(Astro.url.pathname));
const n = (id: string) => all.findIndex((s) => s.id === id) + 1;
const sorted = [...ids].sort((a, b) => n(a) - n(b));
---

{
  sorted.length > 0 && (
    <sup class="ref">
      {sorted.map((id, i) => (
        <>
          {i > 0 && ','}
          <a href={`${base}#src-${id}`} aria-label={t.source(n(id))}>[{n(id)}]</a>
        </>
      ))}
    </sup>
  )
}

---
import MarketHome from '../../components/pages/MarketHome.astro';
import { getActiveMarkets, getMarketDevices, type Market } from '../../lib/markets';
import type { Device } from '../../lib/devices';

export async function getStaticPaths() {
  const markets = await getActiveMarkets();
  return Promise.all(
    markets.map(async (market) => ({ params: { market: market.key }, props: { market, devices: await getMarketDevices(market) } })),
  );
}

const { market, devices } = Astro.props as { market: Market; devices: Device[] };
---

<MarketHome market={market} devices={devices} />

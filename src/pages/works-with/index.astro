---
import Base from '../../layouts/Base.astro';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, ecosystemSlug, getPublishedDevices, worksWith } from '../../lib/devices';

const all = await getPublishedDevices();
---

<Base
  title="Smart home devices by ecosystem"
  description="Find smart home devices that work with Apple Home, Google Home, Amazon Alexa, SmartThings or Home Assistant, with a source for every answer."
  crumbs={[{ name: 'By ecosystem', path: '/works-with/' }]}
>
  <h1>Browse by ecosystem</h1>
  <p class="lede">Pick the platform you already use.</p>
  <ul class="cards">
    {
      ECOSYSTEMS.map((e) => (
        <li class="card">
          <h3><a href={`/works-with/${ecosystemSlug(e)}/`}>{ECOSYSTEM_LABELS[e]}</a></h3>
          <div class="muted">{all.filter((d) => worksWith(d, e)).length} compatible devices</div>
        </li>
      ))
    }
    <li class="card">
      <h3><a href="/works-with/matter/">Matter</a></h3>
      <div class="muted">{all.filter((d) => d.data.matter.certified).length} Matter-certified devices</div>
    </li>
  </ul>
</Base>

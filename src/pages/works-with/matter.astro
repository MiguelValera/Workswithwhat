---
import Base from '../../layouts/Base.astro';
import Refs from '../../components/Refs.astro';
import { RADIO_LABELS, devicePath, getPublishedDevices, listJoin } from '../../lib/devices';
import { CATEGORIES, specFacts } from '../../lib/categories';

const all = await getPublishedDevices();
const matter = all.filter((d) => d.data.matter.certified);
const groups = CATEGORIES.map((cat) => {
  const list = matter.filter((d) => d.data.category === cat.key);
  return {
    cat,
    list,
    wifi: list.filter((d) => d.data.matter.transport === 'wifi'),
    thread: list.filter((d) => d.data.matter.transport === 'thread'),
  };
}).filter((g) => g.list.length > 0);
const what = listJoin(groups.map((g) => g.cat.plural));

const title = `Matter ${what}`;
const description = `${matter.length} Matter-certified ${what}, split by Wi-Fi and Thread, with what each needs to work in Apple Home, Google Home, Alexa, SmartThings and Home Assistant.`;
---

<Base
  title={title}
  description={description}
  crumbs={[
    { name: 'By ecosystem', path: '/works-with/' },
    { name: 'Matter', path: '/works-with/matter/' },
  ]}
>
  <h1>{title.replace(/^./, (c) => c.toUpperCase())}</h1>
  <p class="lede">
    {matter.length} of the {all.length} devices we've checked are Matter-certified:
    {' '}{matter.filter((d) => d.data.matter.transport === 'wifi').length} over Wi-Fi and
    {' '}{matter.filter((d) => d.data.matter.transport === 'thread').length} over Thread.
  </p>

  <h2>What Matter means for a device</h2>
  <p>
    A Matter-certified device can be added to any platform that acts as a Matter controller, including Apple Home,
    Google Home, Alexa, SmartThings and Home Assistant, without the brand's own skill or cloud. You can also share
    it with more than one platform at once.
  </p>
  <p>
    <strong>Wi-Fi devices</strong> join your existing network. <strong>Thread devices</strong> use a low-power mesh and
    need a Thread border router, which many recent smart speakers and streaming boxes include. Either way, the
    platform you add it to needs its own Matter hub for automations and remote access.
  </p>

  {
    groups.map((g) =>
      [
        { label: 'over Wi-Fi', list: g.wifi },
        { label: 'over Thread', list: g.thread },
      ].map(
        (t) =>
          t.list.length > 0 && (
            <>
              <h2>Matter {g.cat.plural} {t.label}</h2>
              <div class="table-scroll">
                <table role="table" class="stack pair">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th role="columnheader" scope="col">Device</th>
                      <th role="columnheader" scope="col">Radios</th>
                      <th role="columnheader" scope="col">{g.cat.specs[0].label}</th>
                      <th role="columnheader" scope="col">Notes</th>
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    {t.list.map((d) => (
                      <tr role="row">
                        <th role="rowheader" scope="row" class="name">
                          <a href={devicePath(d)}>{d.data.name}</a>
                          <span class="note">{d.data.model} · {d.data.regions.join('/')}</span>
                        </th>
                        <td role="cell" data-label="Radios">{(d.data.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || '—'}</td>
                        <td role="cell" data-label={g.cat.specs[0].label}>{specFacts(d.data)[0].text}</td>
                        <td role="cell" class="wide">{d.data.matter.note}<Refs ids={d.data.matter.sources} all={d.data.sources} base={devicePath(d)} /></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          ),
      ),
    )
  }

  <p class="muted small">
    Only devices that are Matter-certified themselves are listed. Devices that reach Matter through a bridge (such as
    a Zigbee device behind a hub) are on the full charts.
  </p>
</Base>

---
import EcosystemPage from '../../components/pages/EcosystemPage.astro';
import { ECOSYSTEMS, ecosystemSlug, type Ecosystem } from '../../lib/devices';

export function getStaticPaths() {
  return ECOSYSTEMS.map((e) => ({ params: { ecosystem: ecosystemSlug(e) }, props: { eco: e } }));
}

const { eco } = Astro.props as { eco: Ecosystem };
---

<EcosystemPage eco={eco} />

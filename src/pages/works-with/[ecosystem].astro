---
import Base from '../../layouts/Base.astro';
import Refs from '../../components/Refs.astro';
import Status from '../../components/Status.astro';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  RADIO_LABELS,
  devicePath,
  ecosystemSlug,
  getPublishedDevices,
  listJoin,
  worksWith,
  type Ecosystem,
} from '../../lib/devices';
import { CATEGORIES } from '../../lib/categories';

export function getStaticPaths() {
  return ECOSYSTEMS.map((e) => ({ params: { ecosystem: ecosystemSlug(e) }, props: { eco: e } }));
}

const { eco } = Astro.props as { eco: Ecosystem };
const label = ECOSYSTEM_LABELS[eco];
const all = await getPublishedDevices();
const yes = all.filter((d) => worksWith(d, eco));
const viaMatter = yes.filter((d) => d.data.compatibility[eco].status === 'matter').length;
const groups = CATEGORIES.map((cat) => ({
  cat,
  yes: yes.filter((d) => d.data.category === cat.key),
  unsure: all.filter((d) => d.data.category === cat.key && d.data.compatibility[eco].status === 'unknown'),
  total: all.filter((d) => d.data.category === cat.key).length,
})).filter((g) => g.total > 0);
const what = listJoin(groups.map((g) => g.cat.plural));
const What = what.replace(/^./, (c) => c.toUpperCase());

// General, stable facts about how devices reach each platform. Device-specific
// claims stay in the device records, where they are sourced.
const HOW: Record<Ecosystem, string[]> = {
  apple_home: [
    'A device reaches Apple Home in one of two ways: it supports HomeKit directly, or it is Matter-certified and you add it with the Home app\'s Matter pairing.',
    'Automations and remote control need an Apple home hub (an Apple TV or a HomePod). Thread devices also need a Thread border router, which recent HomePod and Apple TV models include.',
  ],
  google_home: [
    'Devices connect to Google Home through the brand\'s own account linking (cloud to cloud) or through Matter.',
    'Matter needs a Google device that acts as a Matter hub, such as a Nest speaker or display. Thread devices also need a Google device that works as a Thread border router.',
  ],
  alexa: [
    'Devices connect to Alexa through the brand\'s Alexa skill (cloud to cloud) or through Matter.',
    'Matter needs an Echo device that works as a Matter controller, and Thread devices need an Echo that is also a Thread border router.',
  ],
  smartthings: [
    'Devices reach SmartThings through a cloud-to-cloud integration, through Matter, or as Zigbee devices paired to a SmartThings hub.',
    'Matter and Zigbee devices need a SmartThings hub. Some Samsung TVs and appliances can act as one.',
  ],
  home_assistant: [
    'Home Assistant connects to devices through brand integrations (many of them local), through its Matter integration, or through a Zigbee coordinator.',
    'Local integrations keep working without the internet, which is why we note local control on each device.',
  ],
};

const title = `${What} that work with ${label}`;
const description = `${yes.length} ${what} confirmed to work with ${label}${viaMatter ? `, ${viaMatter} of them via Matter` : ''}. See which need a hub, and check the source for each one.`;
---

<Base
  title={title}
  description={description}
  crumbs={[
    { name: 'By ecosystem', path: '/works-with/' },
    { name: label, path: `/works-with/${ecosystemSlug(eco)}/` },
  ]}
>
  <h1>{title}</h1>
  <p class="lede">
    {yes.length} of the {all.length} devices we've checked work with {label}.
    {viaMatter > 0 && ` ${viaMatter} connect through Matter rather than a brand integration.`}
  </p>
  <h2>How devices connect to {label}</h2>
  {HOW[eco].map((p) => <p>{p}</p>)}

  {
    groups.map((g) => (
      <section>
        <h2>{g.cat.label} that work with {label}</h2>
        {g.yes.length > 0 ? (
          <div class="table-scroll">
            <table class="stack pair">
              <thead>
                <tr><th scope="col">Device</th><th scope="col">How</th><th scope="col">Radio</th><th scope="col">Notes</th></tr>
              </thead>
              <tbody>
                {g.yes.map((d) => {
                  const c = d.data.compatibility[eco];
                  return (
                    <tr>
                      <th scope="row" class="name">
                        <a href={devicePath(d)}>{d.data.name}</a>
                        <span class="note">{d.data.model} · {d.data.regions.join('/')}</span>
                      </th>
                      <td data-label="How"><Status status={c.status} via={c.via} /></td>
                      <td data-label="Radio">{(d.data.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || '—'}</td>
                      <td class="wide">{c.note}<Refs ids={c.sources} all={d.data.sources} base={devicePath(d)} /></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <p>None of the {g.cat.plural} we've checked so far are confirmed for {label}.</p>
        )}
        {g.unsure.length > 0 && (
          <p class="muted small">
            Not confirmed either way:{' '}
            {g.unsure.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={devicePath(d)}>{d.data.name}</a>
              </>
            ))}.
          </p>
        )}
      </section>
    ))
  }

  <p class="muted">
    Other platforms:{' '}
    {
      ECOSYSTEMS.filter((e) => e !== eco).map((e, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/works-with/${ecosystemSlug(e)}/`}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

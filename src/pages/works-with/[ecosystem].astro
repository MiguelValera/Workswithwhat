---
import Base from '../../layouts/Base.astro';
import Refs from '../../components/Refs.astro';
import Status from '../../components/Status.astro';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  RADIO_LABELS,
  devicePath,
  ecosystemSlug,
  getPublishedDevices,
  worksWith,
  type Ecosystem,
} from '../../lib/devices';

export function getStaticPaths() {
  return ECOSYSTEMS.map((e) => ({ params: { ecosystem: ecosystemSlug(e) }, props: { eco: e } }));
}

const { eco } = Astro.props as { eco: Ecosystem };
const label = ECOSYSTEM_LABELS[eco];
const all = await getPublishedDevices();
const yes = all.filter((d) => worksWith(d, eco));
const unsure = all.filter((d) => d.data.compatibility[eco].status === 'unknown');
const viaMatter = yes.filter((d) => d.data.compatibility[eco].status === 'matter').length;

// General, stable facts about how plugs reach each platform. Device-specific
// claims stay in the device records, where they are sourced.
const HOW: Record<Ecosystem, string[]> = {
  apple_home: [
    'A plug reaches Apple Home in one of two ways: it supports HomeKit directly, or it is Matter-certified and you add it with the Home app\'s Matter pairing.',
    'Automations and remote control need an Apple home hub (an Apple TV or a HomePod). Thread plugs also need a Thread border router, which recent HomePod and Apple TV models include.',
  ],
  google_home: [
    'Plugs connect to Google Home through the brand\'s own account linking (cloud to cloud) or through Matter.',
    'Matter needs a Google device that acts as a Matter hub, such as a Nest speaker or display. Thread plugs also need a Google device that works as a Thread border router.',
  ],
  alexa: [
    'Plugs connect to Alexa through the brand\'s Alexa skill (cloud to cloud) or through Matter.',
    'Matter needs an Echo device that works as a Matter controller, and Thread plugs need an Echo that is also a Thread border router.',
  ],
  smartthings: [
    'Plugs reach SmartThings through a cloud-to-cloud integration, through Matter, or as Zigbee devices paired to a SmartThings hub.',
    'Matter and Zigbee devices need a SmartThings hub. Some Samsung TVs and appliances can act as one.',
  ],
  home_assistant: [
    'Home Assistant connects to plugs through brand integrations (many of them local), through its Matter integration, or through a Zigbee coordinator.',
    'Local integrations keep working without the internet, which is why we note local control on each plug.',
  ],
};

const title = `Smart plugs that work with ${label}`;
const description = `${yes.length} smart plugs confirmed to work with ${label}${viaMatter ? `, ${viaMatter} of them via Matter` : ''}. See which need a hub, and check the source for each one.`;
---

<Base
  title={title}
  description={description}
  crumbs={[
    { name: 'By ecosystem', path: '/works-with/' },
    { name: label, path: `/works-with/${ecosystemSlug(eco)}/` },
  ]}
>
  <h1>{title}</h1>
  <p class="lede">
    {yes.length} of the {all.length} plugs we've checked work with {label}.
    {viaMatter > 0 && ` ${viaMatter} connect through Matter rather than a brand integration.`}
  </p>
  <h2>How plugs connect to {label}</h2>
  {HOW[eco].map((p) => <p>{p}</p>)}

  <h2>Compatible plugs</h2>

  {
    yes.length > 0 && (
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th scope="col">Plug</th><th scope="col">How</th><th scope="col">Radio</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {yes.map((d) => {
              const c = d.data.compatibility[eco];
              return (
                <tr>
                  <th scope="row" class="name">
                    <a href={devicePath(d)}>{d.data.name}</a>
                    <span class="note">{d.data.model} · {d.data.regions.join('/')}</span>
                  </th>
                  <td><Status status={c.status} via={c.via} /></td>
                  <td>{(d.data.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || '—'}</td>
                  <td>{c.note}<Refs ids={c.sources} all={d.data.sources} /></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }

  {
    unsure.length > 0 && (
      <>
        <h2>Not confirmed yet</h2>
        <p>
          We couldn't find an official source either way for{' '}
          {unsure.map((d, i) => (
            <>
              {i > 0 && ', '}
              <a href={devicePath(d)}>{d.data.name}</a>
            </>
          ))}.
        </p>
      </>
    )
  }

  <p class="muted">
    Other platforms:{' '}
    {
      ECOSYSTEMS.filter((e) => e !== eco).map((e, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/works-with/${ecosystemSlug(e)}/`}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

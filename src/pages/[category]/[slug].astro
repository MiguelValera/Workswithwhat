---
import Base from '../../layouts/Base.astro';
import Refs from '../../components/Refs.astro';
import Status from '../../components/Status.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import { categoryOf, specFacts } from '../../lib/categories';
import {
  ECOSYSTEMS,
  ECOSYSTEM_LABELS,
  RADIO_LABELS,
  answerFor,
  deviceTitle,
  ecosystemSlug,
  formatDate,
  listJoin,
  getPublishedDevices,
  worksWith,
  type Device,
} from '../../lib/devices';

export async function getStaticPaths() {
  const devices = await getPublishedDevices();
  return devices.map((device) => ({
    params: { category: categoryOf(device.data).path, slug: device.id },
    props: { device, devices },
  }));
}

interface Props {
  device: Device;
  devices: Device[];
}
const { device, devices } = Astro.props;
const d = device.data;
const src = d.sources;
const cat = categoryOf(d);
const specs = specFacts(d);

const works = ECOSYSTEMS.filter((e) => worksWith(device, e)).map((e) => ECOSYSTEM_LABELS[e]);
const list = listJoin;

const title = deviceTitle(device);
const description = works.length
  ? `${d.name} (${d.model}) works with ${list(works)}. Connection type, hub needs and specs, each linked to its source.`
  : `${d.name} (${d.model}) compatibility with Apple Home, Google Home, Alexa, SmartThings and Home Assistant, with sources.`;

const yesNo = (v: boolean | null) => (v === null ? 'Unconfirmed' : v ? 'Yes' : 'No');
const radios = (d.radios.value ?? []).map((r) => RADIO_LABELS[r]).join(', ') || 'Unconfirmed';
const matterText =
  d.matter.certified === null
    ? 'Unconfirmed'
    : d.matter.certified
      ? `Yes, over ${d.matter.transport === 'wifi' ? 'Wi-Fi' : d.matter.transport === 'thread' ? 'Thread' : 'Ethernet'}`
      : 'No';

const related = devices
  .filter((o) => o.id !== device.id && o.data.category === d.category && o.data.regions.some((r) => d.regions.includes(r)))
  .slice(0, 3);

const faq = ECOSYSTEMS.map((e) => ({
  eco: e,
  q: `Does the ${d.name} work with ${ECOSYSTEM_LABELS[e]}?`,
  a: answerFor(device, e),
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    dateModified: d.updatedAt,
    ...(d.verifiedAt && { lastReviewed: d.verifiedAt }),
    mainEntity: {
      '@type': 'Product',
      name: d.name,
      model: d.model,
      brand: { '@type': 'Brand', name: d.brand },
      category: cat.singular.replace(/^./, (c) => c.toUpperCase()),
      description: d.summary,
      url: d.officialUrl,
    },
  },
];
---

<Base
  title={title}
  description={description}
  ogType="article"
  crumbs={[
    { name: cat.label, path: `/${cat.path}/` },
    { name: d.name, path: `/${cat.path}/${device.id}/` },
  ]}
  jsonLd={jsonLd}
>
  <article>
    {d.status === 'draft' && <p class="badge s-hub">Draft, not published (visible in dev only)</p>}
    <h1>{d.name}: what it works with</h1>
    <p class="muted">
      {d.brand} · model {d.model} · sold in {d.regions.join(', ')}
    </p>
    <ul class="glance" aria-label="Compatibility at a glance">
      <li>
        <a href="#compat-matter"><span class="glance-eco">Matter</span> <span class={`badge s-${d.matter.certified}`}>{matterText}</span></a>
      </li>
      {
        ECOSYSTEMS.map((e) => (
          <li>
            <a href={`#compat-${ecosystemSlug(e)}`}>
              <span class="glance-eco">{ECOSYSTEM_LABELS[e]}</span> <Status status={d.compatibility[e].status} via={d.compatibility[e].via} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="lede">{d.summary}</p>
    {
      d.verifiedAt && (
        <p class="verified">
          Checked against {src.length} sources on <time datetime={d.verifiedAt}>{formatDate(d.verifiedAt)}</time>
        </p>
      )
    }

    <nav class="toc" aria-label="On this page">
      <span class="toc-label">On this page:</span>
      <a href="#compat">Compatibility</a>
      <a href="#specs">Specs</a>
      {d.caveats.length > 0 && <a href="#before-you-buy">Before you buy</a>}
      <a href="#quick-answers">Quick answers</a>
      <a href="#sources">Sources</a>
      {related.length > 0 && <a href="#related">Similar {cat.plural}</a>}
    </nav>

    <h2 id="compat">Ecosystem compatibility</h2>
    <div class="table-scroll">
      <table role="table" class="stack kv">
        <thead role="rowgroup">
          <tr role="row"><th role="columnheader" scope="col">Platform</th><th role="columnheader" scope="col">Works?</th><th role="columnheader" scope="col">Details</th></tr>
        </thead>
        <tbody role="rowgroup">
          <tr role="row" id="compat-matter">
            <th role="rowheader" scope="row">Matter</th>
            <td role="cell"><span class={`badge s-${d.matter.certified}`}>{matterText}</span></td>
            <td role="cell" class="wide">
              {d.matter.note}<Refs ids={d.matter.sources} all={src} />
              {d.matter.certified && <> <a href="/works-with/matter/">Other Matter {cat.plural}</a></>}
            </td>
          </tr>
          {
            ECOSYSTEMS.map((e) => {
              const c = d.compatibility[e];
              return (
                <tr role="row" id={`compat-${ecosystemSlug(e)}`}>
                  <th role="rowheader" scope="row">{ECOSYSTEM_LABELS[e]}</th>
                  <td role="cell"><Status status={c.status} via={c.via} /></td>
                  <td role="cell" class="wide">{c.note}<Refs ids={c.sources} all={src} /></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="muted small">
      “Via Matter” means you add it with that platform's Matter controller instead of a brand skill or app.
      “Unconfirmed” means we couldn't find an official source either way.{' '}
      <a href="/methodology/">How we verify</a>.
    </p>

    <h2 id="specs">Specs that matter for setup</h2>
    <dl class="facts">
      <div><dt>Radio</dt><dd>{radios}<Refs ids={d.radios.sources} all={src} /></dd></div>
      <div><dt>Hub required</dt><dd>{yesNo(d.hubRequired.value)}<Refs ids={d.hubRequired.sources} all={src} /></dd></div>
      <div><dt>Local control</dt><dd>{yesNo(d.localControl.value)}<Refs ids={d.localControl.sources} all={src} /></dd></div>
      {specs.map((s) => <div><dt>{s.label}</dt><dd>{s.text}<Refs ids={s.fact.sources} all={src} /></dd></div>)}
    </dl>
    {
      [d.hubRequired, d.localControl, d.radios, ...specs.map((s) => s.fact)].some((f) => f.note) && (
        <ul class="muted small">
          {d.radios.note && <li>Radio: {d.radios.note}</li>}
          {d.hubRequired.note && <li>Hub: {d.hubRequired.note}</li>}
          {d.localControl.note && <li>Local control: {d.localControl.note}</li>}
          {specs.map((s) => s.fact.note && <li>{s.label}: {s.fact.note}</li>)}
        </ul>
      )
    }

    {
      d.caveats.length > 0 && (
        <>
          <h2 id="before-you-buy">Before you buy</h2>
          <ul class="caveats">
            {d.caveats.map((c) => <li>{c}</li>)}
          </ul>
        </>
      )
    }

    <h2 id="quick-answers">Quick answers</h2>
    <dl class="faq">
      {
        faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>
              {f.a}{' '}
              {worksWith(device, f.eco) && (
                <a href={`/works-with/${ecosystemSlug(f.eco)}/`}>More {cat.plural} for {ECOSYSTEM_LABELS[f.eco]}</a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 id="sources">Sources</h2>
    <ol class="sources">
      {
        src.map((s) => (
          <li id={`src-${s.id}`}>
            <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> — {s.publisher}{' '}
            <span class="kind">{s.kind}</span> <span class="muted">· accessed {formatDate(s.accessed)}</span>
          </li>
        ))
      }
    </ol>
    <p class="muted">
      Official product page: <a href={d.officialUrl} rel="nofollow noopener">{new URL(d.officialUrl).hostname}</a>
    </p>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related">Other {cat.plural} for the same region</h2>
        <ul class="cards">
          {related.map((r) => <DeviceCard device={r} />)}
        </ul>
      </section>
    )
  }
</Base>

---
import DevicePage from '../../components/pages/DevicePage.astro';
import { categoryOf } from '../../lib/categories';
import { getPublishedDevices, type Device } from '../../lib/devices';

export async function getStaticPaths() {
  const devices = await getPublishedDevices();
  return devices.map((device) => ({
    params: { category: categoryOf(device.data).path, slug: device.id },
    props: { device, devices },
  }));
}

const { device, devices } = Astro.props as { device: Device; devices: Device[] };
---

<DevicePage device={device} devices={devices} />

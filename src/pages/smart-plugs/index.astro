---
import Base from '../../layouts/Base.astro';
import CompareTable from '../../components/CompareTable.astro';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, ecosystemSlug, formatDate, getPublishedDevices } from '../../lib/devices';

const devices = await getPublishedDevices();
const title = 'Smart plug compatibility chart: Apple Home, Google Home, Alexa, Matter';
const description = `${devices.length} smart plugs compared by ecosystem support, radio, Matter certification and hub needs. Every cell links back to a source.`;

const newest = devices.map((d) => d.data.updatedAt).sort().at(-1);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Smart plug ecosystem compatibility',
    description,
    url: new URL('/smart-plugs/', Astro.site).href,
    ...(newest && { dateModified: newest }),
    creator: { '@type': 'Organization', name: 'Workswithwhat', url: Astro.site!.href },
    variableMeasured: ['Matter certification', ...ECOSYSTEMS.map((e) => `${ECOSYSTEM_LABELS[e]} compatibility`)],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL('/api/smart-plugs.json', Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Smart plugs',
    itemListElement: devices.map((d, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/smart-plugs/${d.id}/`, Astro.site).href,
      name: d.data.name,
    })),
  },
];
---

<Base title={title} description={description} crumbs={[{ name: 'Smart plugs', path: '/smart-plugs/' }]} jsonLd={jsonLd}>
  <h1>Smart plug compatibility chart</h1>
  <p class="lede">
    Which plug works with which platform, and how it gets there: directly, over Matter, or through a hub.
    Open any plug for the details and the sources behind each answer.
  </p>
  <CompareTable devices={devices} />
  {newest && <p class="muted small">Last updated <time datetime={newest}>{formatDate(newest)}</time>. The same data is available as <a href="/api/smart-plugs.json">JSON</a>.</p>}
  <p class="muted">
    Looking for one platform?{' '}
    {
      ECOSYSTEMS.map((e, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/works-with/${ecosystemSlug(e)}/`}>{ECOSYSTEM_LABELS[e]}</a>
        </>
      ))
    }
  </p>
</Base>

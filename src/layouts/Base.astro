---
import '../styles/global.css';
import { ECOSYSTEMS, ECOSYSTEM_LABELS, ecosystemSlug, getActiveCategories } from '../lib/devices';
import { getActiveMarkets, getRegionPages, marketText } from '../lib/markets';
import { catText } from '../lib/categories';
import MailLink from '../components/MailLink.astro';
import { ACTIVE_LANGS, HTML_LANG, LANG_NAMES, OG_LOCALE, langOf, localize, toEnglish } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Crumb {
  name: string;
  path: string;
}
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** false for pages that exist in one language only (the 404 page) */
  alternates?: boolean;
  /** pages that must stay out of search results (404): noindex and no canonical */
  noindex?: boolean;
}

const { title, description, crumbs = [], jsonLd = [], ogType = 'website', alternates = true, noindex = false } = Astro.props;
// Pages pass English paths in crumbs; this layout localizes every link it builds.
const lang = langOf(Astro.url.pathname);
const t = ui(lang);
const L = (p: string) => localize(p, lang);
const site = Astro.site!;
const navCategories = await getActiveCategories();
const canonical = new URL(Astro.url.pathname, site).href;
// everything below works on the English path; links are localized when rendered
const here = toEnglish(Astro.url.pathname);
// the same page in each built language (hreflang + language switch)
const langLinks = alternates && ACTIVE_LANGS.length > 1 ? ACTIVE_LANGS.map((l) => ({ l, href: localize(here, l) })) : [];


// Region switch: the same page for another market when it exists, else that market's
// closest page (its chart for a device page, then its home). "All" is the page without a region.
const markets = await getActiveMarkets();
const regionPaths = new Set((await getRegionPages()).map((p) => p.path));
const hereMarket = markets.find((m) => here === `/${m.key}/` || here.startsWith(`/${m.key}/`));
const rest = hereMarket ? here.slice(hereMarket.key.length + 1) : here;
const firstSegment = rest.split('/')[1];
// main nav: /us/smart-plugs/ still belongs to the Plugs section
const current = (path: string) => (here === path ? 'page' : rest.startsWith(path) ? 'true' : undefined);
const regionLinks = markets.map((m) => {
  const candidates = [`/${m.key}${rest}`, firstSegment ? `/${m.key}/${firstSegment}/` : '', `/${m.key}/`];
  return { m, href: candidates.find((c) => regionPaths.has(c)) ?? `/${m.key}/` };
});
const inCategory = navCategories.find((c) => rest.startsWith(`/${c.path}/`));
// keep titles short enough for search results; long question titles drop the brand suffix
const fullTitle = here === '/' || title.length > 50 ? title : `${title} | Workswithwhat`;

const structured = [...jsonLd];
if (crumbs.length) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: t.home, path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(L(c.path), site).href,
    })),
  });
}
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Model numbers and EANs aren't phone numbers; stop iOS Safari linking them -->
    <meta name="format-detection" content="telephone=no" />
    {
      /* production only: the dev server injects its own scripts and styles */
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"
        />
      )
    }
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {langLinks.map(({ l, href }) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(href, site).href} />)}
    {langLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(here, site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f766e" />
    <meta property="og:site_name" content="Workswithwhat" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI assistants" />
    <link rel="alternate" type="application/json" href="/api/devices.json" title="Device data (JSON)" />
    {structured.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={L('/')}>works<span>with</span>what</a>
        <nav class="primary" aria-label={t.mainNav}>
          <details class={`menu${inCategory ? ' is-current' : ''}`}>
            <summary>
              <span class="only-wide">{t.navDevices}</span><span class="only-narrow">{t.navMenu}</span>
              {inCategory && <span class="sr-only"> ({catText(inCategory, lang).label})</span>}
            </summary>
            <div class="panel">
              <ul class="cat-grid">
                {navCategories.map((c) => <li><a href={L(`/${c.path}/`)} aria-current={current(`/${c.path}/`)}>{catText(c, lang).label}</a></li>)}
              </ul>
              <ul class="only-narrow extra">
                <li><a href={L('/works-with/')} aria-current={current('/works-with/')}>{t.navByEcosystem}</a></li>
                <li><a href={L('/methodology/')} aria-current={current('/methodology/')}>{t.navHowWeVerify}</a></li>
              </ul>
            </div>
          </details>
          <a class="only-wide" href={L('/works-with/')} aria-current={current('/works-with/')}>{t.navByEcosystem}</a>
          <a class="only-wide" href={L('/methodology/')} aria-current={current('/methodology/')}>{t.navHowWeVerify}</a>
        </nav>
        {
          markets.length > 1 && !noindex && (
            <details class="locale">
              <summary>
                <span>{lang.toUpperCase()}</span><span class="sep" aria-hidden="true">·</span><span class="only-wide">{hereMarket ? marketText(hereMarket, lang).label : t.regionAllLong}</span>
                <span class="only-narrow">{hereMarket ? marketText(hereMarket, lang).short : t.regionAll}</span>
                <span class="sr-only"> ({t.language} / {t.region})</span>
              </summary>
              <div class="panel">
                <nav aria-label={t.region}>
                  <span class="muted">{t.region}</span>
                  <ul>
                    <li><a href={L(rest)} aria-current={hereMarket ? undefined : 'true'}>{t.regionAllLong}</a></li>
                    {regionLinks.map(({ m, href }) => (
                      <li>
                        <a href={L(href)} aria-current={hereMarket === m ? 'true' : undefined}>{marketText(m, lang).label}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
                {langLinks.length > 0 && (
                  <div class="langs" role="group" aria-label={t.language}>
                    <span class="muted">{t.language}</span>
                    <ul>
                      {langLinks.map(({ l, href }) => (
                        <li>
                          <a href={href} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]}>
                            {LANG_NAMES[l]}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </details>
          )
        }
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label={t.breadcrumb}>
            <a href={L('/')}>{t.home}</a>
            {crumbs.map((c, i) =>
              i === crumbs.length - 1 ? (
                <span aria-current="page">{c.name}</span>
              ) : (
                <a href={L(c.path)}>{c.name}</a>
              ),
            )}
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav class="directory" aria-label={t.footerDirectory}>
          <div>
            <p class="dir-title">{t.navDevices}</p>
            <ul>{navCategories.map((c) => <li><a href={L(`/${c.path}/`)}>{catText(c, lang).label}</a></li>)}</ul>
          </div>
          <div>
            <p class="dir-title">{t.navByEcosystem}</p>
            <ul>
              {ECOSYSTEMS.map((e) => <li><a href={L(`/works-with/${ecosystemSlug(e)}/`)}>{ECOSYSTEM_LABELS[e]}</a></li>)}
              <li><a href={L('/works-with/matter/')}>Matter</a></li>
            </ul>
          </div>
          {markets.length > 1 && (
            <div>
              <p class="dir-title">{t.region}</p>
              <ul>{markets.map((m) => <li><a href={L(`/${m.key}/`)}>{marketText(m, lang).label}</a></li>)}</ul>
            </div>
          )}
          {langLinks.length > 0 && (
            <div>
              <p class="dir-title">{t.language}</p>
              <ul>{langLinks.map(({ l, href }) => <li><a href={href} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]}>{LANG_NAMES[l]}</a></li>)}</ul>
            </div>
          )}
        </nav>
        <p>
          {t.footerCorrection}{' '}
          <MailLink subject={t.footerMailSubject}>{t.footerTellUs}</MailLink>.
          {t.missingDevice}{' '}
          <MailLink subject={t.missingDeviceSubject} body={t.missingDeviceBody}>{t.missingDeviceLink}</MailLink>.
        </p>
        <p class="muted">
          {t.footerNotAffiliated}
        </p>
        <p class="muted small">
          <a href={L('/legal/')}>{t.legalNotice}</a> · <a href={L('/privacy/')}>{t.privacy}</a> · <a href={L('/methodology/')}>{t.navHowWeVerify}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

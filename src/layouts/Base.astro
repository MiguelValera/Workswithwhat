---
import '../styles/global.css';
import { getActiveCategories } from '../lib/devices';
import { OPERATOR } from '../site.config';

interface Crumb {
  name: string;
  path: string;
}
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: object[];
  ogType?: 'website' | 'article';
}

const { title, description, crumbs = [], jsonLd = [], ogType = 'website' } = Astro.props;
const site = Astro.site!;
const navCategories = await getActiveCategories();
const canonical = new URL(Astro.url.pathname, site).href;
// marks the main-nav link for the current section (aria-current is also the styling hook)
const here = Astro.url.pathname;
const current = (path: string) => (here === path ? 'page' : here.startsWith(path) ? 'true' : undefined);
// keep titles short enough for search results; long question titles drop the brand suffix
const fullTitle = Astro.url.pathname === '/' || title.length > 50 ? title : `${title} | Workswithwhat`;

const structured = [...jsonLd];
if (crumbs.length) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, site).href,
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Model numbers and EANs aren't phone numbers; stop iOS Safari linking them -->
    <meta name="format-detection" content="telephone=no" />
    {
      /* production only: the dev server injects its own scripts and styles */
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"
        />
      )
    }
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f766e" />
    <meta property="og:site_name" content="Workswithwhat" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Workswithwhat: smart home compatibility, checked against official sources" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI assistants" />
    <link rel="alternate" type="application/json" href="/api/devices.json" title="Device data (JSON)" />
    {structured.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">works<span>with</span>what</a>
        <nav aria-label="Main">
          {navCategories.map((c) => <a href={`/${c.path}/`} aria-current={current(`/${c.path}/`)}>{c.label}</a>)}
          <a href="/works-with/" aria-current={current('/works-with/')}>By ecosystem</a>
          <a href="/methodology/" aria-current={current('/methodology/')}>How we verify</a>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((c, i) =>
              i === crumbs.length - 1 ? (
                <span aria-current="page">{c.name}</span>
              ) : (
                <a href={c.path}>{c.name}</a>
              ),
            )}
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Every claim links to its source. Spotted something wrong or out of date?{' '}
          <a href={`mailto:${OPERATOR.email}?subject=${encodeURIComponent('Correction for workswithwhat.com')}`}>Tell us</a>.
        </p>
        <p class="muted">
          Not affiliated with any brand mentioned. Trademarks belong to their owners. No cookies, no trackers.
        </p>
        <p class="muted small">
          <a href="/legal/">Legal notice</a> · <a href="/privacy/">Privacy and cookies</a> · <a href="/methodology/">How we verify</a>
        </p>
      </div>
    </footer>
  </body>
</html>
